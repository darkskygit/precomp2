///| Bit-exact RFC 1951 analysis, reconstruction, compactness, and security tests for `preflate`.

import "flate"

///|
fn pf_bytes_from_ints(vals : Array[Int]) -> Bytes {
  let n = vals.length()
  let mut b = Bytes::new(n)
  let mut i = 0
  while i < n {
    b[i] = vals[i].to_byte()
    i = i + 1
  }
  b
}

///|
fn pf_bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let n = a.length()
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn pf_repeat_bytes(pat : Bytes, count : Int) -> Bytes {
  let pn = pat.length()
  let mut out = Bytes::new(pn * count)
  let mut c = 0
  while c < count {
    let base = c * pn
    let mut j = 0
    while j < pn {
      out[base + j] = pat[j]
      j = j + 1
    }
    c = c + 1
  }
  out
}

///|
fn pf_make_lcg_bytes(n : Int, seed : Int64) -> Bytes {
  let mut out = Bytes::new(n)
  let mut s = seed
  let mut i = 0
  while i < n {
    s = (s * 6364136223846793005L + 1442695040888963407L) & 0x7FFFFFFFFFFFFFFFL
    out[i] = ((s >> 24) & 0xFFL).to_int().to_byte()
    i = i + 1
  }
  out
}

///|
fn pf_assert_roundtrip(deflate : Bytes, expected_plain : Bytes, label : String) -> PreflateResult {
  let res = match analyze(deflate) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, label + ": analyze failed: " + e)
      PreflateResult::{ compressed_size: 0, corrections: Bytes::new(0), plain: Bytes::new(0) }
    }
  }
  debug_assert(res.compressed_size == deflate.length(), label + ": compressed_size mismatch")
  debug_assert(pf_bytes_eq(res.plain, expected_plain), label + ": plain mismatch")
  let rebuilt = match reencode(res.corrections, res.plain) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, label + ": reencode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(pf_bytes_eq(rebuilt, deflate), label + ": bit-exact reencode mismatch")
  res
}

///|
test "flate_levels_0_to_9_bit_exact_roundtrip_and_compact_corrections" {
  let empty = Bytes::new(0)
  let repetitive = pf_repeat_bytes("The quick brown fox jumps over the lazy dog. ".to_bytes(), 400)
  let structured = pf_repeat_bytes(
    "{\"id\":12345,\"name\":\"alpha-beta\",\"tags\":[\"a\",\"b\",\"c\"],\"ok\":true}\n".to_bytes(),
    300,
  )
  let random_data = pf_make_lcg_bytes(16384, 42L)
  let mixed = repetitive.concat(random_data.slice(0, 4096)).concat(structured)

  let payloads = [empty, repetitive, structured, random_data, mixed]
  let mut pi = 0
  while pi < payloads.length() {
    let plain = payloads[pi]
    let mut level = 0
    while level <= 9 {
      let comp = match flate::deflate_compress(plain, level) {
        Ok(b) => b
        Err(e) => {
          debug_assert(false, "flate compress failed: " + flate::flate_error_message(e))
          Bytes::new(0)
        }
      }
      let res = pf_assert_roundtrip(
        comp,
        plain,
        "flate payload=" + pi.to_string() + " level=" + level.to_string(),
      )
      // Verify real compactness on stored streams and realistic multi-KB compressible streams.
      if pi == 1 && level == 0 {
        debug_assert(res.corrections.length() < 32, "stored corrections should be tiny")
      }
      if pi == 4 && level == 6 {
        debug_assert(
          res.corrections.length() * 4 < comp.length(),
          "flate level 6 mixed corrections should be < 25% of compressed size",
        )
      }
      level = level + 1
    }
    pi = pi + 1
  }
}

///|
test "trailing_bytes_after_final_block_exact_compressed_size" {
  let plain = pf_repeat_bytes("trailing-bytes-test-payload-0123456789\n".to_bytes(), 80)
  let trailer = pf_bytes_from_ints([0xDE, 0xAD, 0xBE, 0xEF, 0x11, 0x22, 0x33, 0x44])
  let levels = [0, 1, 6, 9]
  let mut li = 0
  while li < levels.length() {
    let lvl = levels[li]
    let comp = match flate::deflate_compress(plain, lvl) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    let with_trailer = comp.concat(trailer)
    let res = match analyze_limited(with_trailer, plain.length()) {
      Ok(r) => r
      Err(e) => {
        debug_assert(false, "analyze with trailer failed: " + e)
        PreflateResult::{ compressed_size: 0, corrections: Bytes::new(0), plain: Bytes::new(0) }
      }
    }
    debug_assert(res.compressed_size == comp.length(), "compressed_size must exclude trailer")
    debug_assert(pf_bytes_eq(res.plain, plain), "plain must match")
    let rebuilt = match reencode(res.corrections, res.plain) {
      Ok(b) => b
      Err(_) => Bytes::new(0)
    }
    debug_assert(pf_bytes_eq(rebuilt, comp), "reencode must match exact prefix")
    li = li + 1
  }
}

///|
test "rfc1951_nonzero_padding_alt258_overlap_and_32k_window" {
  // 1. Stored block with non-zero padding bits (0b10110) before byte boundary.
  // BFINAL=1 (1), BTYPE=00 (00), pad=10110 (5 bits) -> byte 0 = 0b10110_001 = 0xB1.
  let stored_pad = pf_bytes_from_ints([0xB1, 3, 0, 252, 255, 65, 66, 67])
  let _ = pf_assert_roundtrip(stored_pad, "ABC".to_bytes(), "stored_nonzero_pad")

  // 2. Final Fixed Huffman block with non-zero trailing padding bits in final byte.
  // Empty fixed block: BFINAL=1, BTYPE=01 (0b011) + EOB 256 (7 bits 0000000) = 10 bits.
  // Remaining 6 bits in byte 1 set to 0b101010 -> byte 0 = 0x03, byte 1 = 0b101010_00 = 0xA8.
  let fixed_pad = pf_bytes_from_ints([0x03, 0xA8])
  let _ = pf_assert_roundtrip(fixed_pad, Bytes::new(0), "fixed_nonzero_trailing_pad")

  // 3. Fixed Huffman block encoding length 258 using non-standard symbol 284 + 5 extra bits (31).
  let bw = BitWriter::new(64)
  bw_write_bits(bw, 3, 3) // BFINAL=1, BTYPE=01
  bw_write_bits(bw, fixed_litlen_codes[65], fixed_litlen_lens[65]) // 'A'
  bw_write_bits(bw, fixed_litlen_codes[284], fixed_litlen_lens[284]) // sym 284 (base 227)
  bw_write_bits(bw, 31, 5) // + 31 = 258
  bw_write_bits(bw, fixed_dist_codes[0], fixed_dist_lens[0]) // dist=1 (overlapping RLE)
  bw_write_bits(bw, fixed_litlen_codes[256], fixed_litlen_lens[256]) // EOB
  let alt258_stream = match bw_finish_with_pad(bw, 0) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let expected_259a = pf_repeat_bytes("A".to_bytes(), 259)
  let _ = pf_assert_roundtrip(alt258_stream, expected_259a, "fixed_alt_258_and_rle")

  // 4. Full 32 KiB window (dist == 32768) across Stored + Fixed multi-block stream.
  let mut big = Bytes::new(32768 + 10)
  big[0] = (0x5A).to_byte()
  big[1] = (0xA5).to_byte()
  big[2] = (0x3C).to_byte()
  big[3] = (0xC3).to_byte()
  big[4] = (0x99).to_byte()
  let mut i = 5
  while i < 32768 {
    big[i] = ((i * 31 + 7) & 0xFF).to_byte()
    i = i + 1
  }
  big[32768] = (0x5A).to_byte()
  big[32769] = (0xA5).to_byte()
  big[32770] = (0x3C).to_byte()
  big[32771] = (0xC3).to_byte()
  big[32772] = (0x99).to_byte()
  big[32773] = big[5]
  big[32774] = big[6]
  big[32775] = big[7]
  big[32776] = big[8]
  big[32777] = big[9]

  let bw2 = BitWriter::new(33000)
  // Block 1: non-final Stored block of 32768 bytes
  bw_write_bits(bw2, 0, 3) // BFINAL=0, BTYPE=00
  let _ = bw_align_byte_with_pad(bw2, 0)
  bw_write_u16_le(bw2, 32768)
  bw_write_u16_le(bw2, 32768 ^ 0xFFFF)
  bw_write_raw(bw2, big, 0, 32768)
  // Block 2: final Fixed block with single match (len=10, dist=32768)
  bw_write_bits(bw2, 3, 3) // BFINAL=1, BTYPE=01
  let lcode = len_to_code[10]
  bw_write_bits(bw2, fixed_litlen_codes[257 + lcode], fixed_litlen_lens[257 + lcode])
  let dcode = dist_to_code(32768)
  bw_write_bits(bw2, fixed_dist_codes[dcode], fixed_dist_lens[dcode])
  bw_write_bits(bw2, 32768 - dist_base[dcode], dist_extra[dcode])
  bw_write_bits(bw2, fixed_litlen_codes[256], fixed_litlen_lens[256])
  let win32k_stream = match bw_finish_with_pad(bw2, 0) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let _ = pf_assert_roundtrip(win32k_stream, big, "full_32k_window_cross_block")
}

