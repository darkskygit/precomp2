    162, 142, 20, 153, 63, 192, 21, 117, 164, 200, 252, 9, 174, 168, 35, 69, 230,
    47, 112, 69, 29, 41, 50, 127, 131, 43, 234, 72, 149, 249, 7, 92, 209, 71,
    170, 200, 87, 1, 87, 52, 146, 42, 243, 5, 92, 81, 73, 234, 236, 90, 81, 73,
    234, 232, 218, 81, 73, 234, 228, 218, 81, 72, 138, 204, 55, 112, 71, 31, 41,
    50, 127, 128, 59, 234, 72, 145, 249, 19, 220, 81, 71, 138, 204, 95, 224, 142,
    58, 82, 100, 254, 6, 119, 212, 145, 34, 243, 15, 184, 163, 142, 20, 145, 175,
    2, 238, 232, 35, 85, 230, 11, 184, 163, 144, 84, 153, 175, 248, 7,
  ])
  let expected_plain = match flate::deflate_decompress(wb9) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let res_wb9 = pf_assert_roundtrip(wb9, expected_plain, "zlib_wbits_9")
  debug_assert(
    res_wb9.corrections.length() * 100 <= wb9.length() * 3,
    "wbits=9 corrections should be <= 3% of compressed size",
  )
  let res_wb12 = pf_assert_roundtrip(wb12, expected_plain, "zlib_wbits_12")
  debug_assert(
    res_wb12.corrections.length() * 100 <= wb12.length() * 3,
    "wbits=12 corrections should be <= 3% of compressed size",
  )
  let res_filt = pf_assert_roundtrip(filtered, expected_plain, "zlib_z_filtered")
  debug_assert(
    res_filt.corrections.length() * 100 <= filtered.length() * 3,
    "Z_FILTERED corrections should be <= 3% of compressed size",
  )
}

///|
test "truncated_compressed_wrapper_does_not_preallocate_declared_size" {
  // Header: "PF", version 1 | flag_compressed (0x11), varint(268435456 = 0x10000000 = 256 MiB),
  // followed by a 1-byte truncated fixed DEFLATE block (0x03). Must fail fast without allocating 256 MiB.
  let crafted = pf_bytes_from_ints([0x50, 0x46, 0x11, 0x80, 0x80, 0x80, 0x80, 0x01, 0x03])
  match reencode(crafted, Bytes::new(0)) {
    Ok(_) => debug_assert(false, "truncated compressed wrapper claiming 256 MiB must fail")
    Err(_) => ()
  }
}
