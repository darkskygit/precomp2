///|
test "plain_limit_zip_bomb_protection_and_invalid_stream_rejection" {
  // Construct a ~10.3 MiB zip bomb in ~65 KiB using fixed Huffman (len=258, dist=1) x 40000.
  let bw = BitWriter::new(70000)
  bw_write_bits(bw, 3, 3) // BFINAL=1, BTYPE=01
  bw_write_bits(bw, fixed_litlen_codes[0], fixed_litlen_lens[0])
  let mut k = 0
  while k < 40000 {
    bw_write_bits(bw, fixed_litlen_codes[285], fixed_litlen_lens[285])
    bw_write_bits(bw, fixed_dist_codes[0], fixed_dist_lens[0])
    k = k + 1
  }
  bw_write_bits(bw, fixed_litlen_codes[256], fixed_litlen_lens[256])
  let bomb = match bw_finish_with_pad(bw, 0) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }

  // Must fail cleanly without OOM when plain_limit is 16 KiB.
  match analyze_limited(bomb, 16384) {
    Ok(_) => debug_assert(false, "zip bomb should exceed plain_limit")
    Err(_) => ()
  }
  // Negative plain_limit must fail cleanly.
  match analyze_limited(pf_bytes_from_ints([3, 0]), -1) {
    Ok(_) => debug_assert(false, "negative plain_limit should fail")
    Err(_) => ()
  }
  // Exact plain_limit boundary must succeed, plain_limit - 1 must fail.
  let stored = pf_bytes_from_ints([1, 4, 0, 251, 255, 10, 20, 30, 40])
  match analyze_limited(stored, 4) {
    Ok(r) => debug_assert(r.plain.length() == 4, "exact plain_limit should succeed")
    Err(e) => debug_assert(false, "exact plain_limit failed: " + e)
  }
  match analyze_limited(stored, 3) {
    Ok(_) => debug_assert(false, "plain_limit - 1 should fail")
    Err(_) => ()
  }

  // Invalid streams must be rejected cleanly.
  let invalid_cases = [
    Bytes::new(0), // empty input
    pf_bytes_from_ints([0x07]), // BTYPE=3 (reserved)
    pf_bytes_from_ints([0x01, 4, 0, 0, 0, 1, 2, 3, 4]), // bad stored NLEN
    pf_bytes_from_ints([0x01, 4, 0, 251, 255, 1, 2]), // truncated stored payload
    pf_bytes_from_ints([0x03]), // truncated fixed block (missing EOB)
    pf_bytes_from_ints([0x05, 0xFF, 0xFF]), // invalid dynamic header (HLIT/HDIST > max)
  ]
  let mut ci = 0
  while ci < invalid_cases.length() {
    match analyze(invalid_cases[ci]) {
      Ok(_) => debug_assert(false, "invalid stream case " + ci.to_string() + " should fail")
      Err(_) => ()
    }
    ci = ci + 1
  }

  // Corrupted corrections must fail cleanly in reencode.
  match reencode(Bytes::new(0), Bytes::new(0)) {
    Ok(_) => debug_assert(false, "empty corrections should fail")
    Err(_) => ()
  }
  match reencode(pf_bytes_from_ints([0x00, 0x00, 0x01]), Bytes::new(0)) {
    Ok(_) => debug_assert(false, "bad magic should fail")
    Err(_) => ()
  }
  match reencode(pf_bytes_from_ints([0x50, 0x46, 0x02, 0x00]), Bytes::new(0)) {
    Ok(_) => debug_assert(false, "unknown version should fail")
    Err(_) => ()
  }
  // Compressed corrections with raw_len == 0 must be rejected.
  match reencode(pf_bytes_from_ints([0x50, 0x46, 0x11, 0x00, 0x03, 0x00]), Bytes::new(0)) {
    Ok(_) => debug_assert(false, "compressed corrections with raw_len=0 should fail")
    Err(_) => ()
  }
  // Trailing bytes after compressed corrections wrapper must be rejected.
  let valid_raw = pf_bytes_from_ints([0x04, 0x00, 0x00]) // 1 empty stored block + pad 0
  let valid_comp = match flate::deflate_compress(valid_raw, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let mut bad_wrapped = pf_bytes_from_ints([0x50, 0x46, 0x11, valid_raw.length()]).concat(valid_comp)
  bad_wrapped = bad_wrapped.concat(pf_bytes_from_ints([0xAA]))
  match reencode(bad_wrapped, Bytes::new(0)) {
    Ok(_) => debug_assert(false, "trailing bytes after compressed wrapper should fail")
    Err(_) => ()
  }
}

///| Build a custom dynamic Huffman block from explicit `(hlit, hdist, lit_lens, dist_lens)` and tokens.
fn pf_build_dynamic_stream(
  hlit : Int,
  hdist : Int,
  lit_lens : FixedArray[Int],
  dist_lens : FixedArray[Int],
  tokens : Array[Int],
  cross_boundary_rle16 : Bool,
) -> Bytes {
  let total = hlit + hdist
  let all : FixedArray[Int] = FixedArray::make(total, 0)
  let mut i = 0
  while i < hlit {
    all[i] = lit_lens[i]
    i = i + 1
  }
  i = 0
  while i < hdist {
    all[hlit + i] = dist_lens[i]
    i = i + 1
  }

  let rle_syms : Array[Int] = []
  let rle_extra : Array[Int] = []
  let bl_freqs : FixedArray[Int] = FixedArray::make(19, 0)
  if cross_boundary_rle16 {
    // Emit concatenated RLE so code 16 can span the litlen/dist boundary.
    zlib_rle_tree(all, total - 1, rle_syms, rle_extra, bl_freqs)
  } else {
    zlib_rle_tree(lit_lens, hlit - 1, rle_syms, rle_extra, bl_freqs)
    zlib_rle_tree(dist_lens, hdist - 1, rle_syms, rle_extra, bl_freqs)
  }

  let cl_lens : FixedArray[Int] = FixedArray::make(19, 0)
  let _ = zlib_build_tree(bl_freqs, 19, 7, cl_lens)
  let mut max_bl = 18
  while max_bl >= 3 && cl_lens[cl_order[max_bl]] == 0 {
    max_bl = max_bl - 1
  }
  let hclen = max_bl + 1
  let cl_codes = match build_canonical_codes(cl_lens, 19, false) {
    Ok(c) => c
    Err(_) => FixedArray::make(19, 0)
  }
  let lit_codes = match build_canonical_codes(lit_lens, hlit, false) {
    Ok(c) => c
    Err(_) => FixedArray::make(288, 0)
  }
  let dist_codes = match build_canonical_codes(dist_lens, hdist, true) {
    Ok(c) => c
    Err(_) => FixedArray::make(32, 0)
  }

  let bw = BitWriter::new(256)
  bw_write_bits(bw, 5, 3) // BFINAL=1, BTYPE=10
  bw_write_bits(bw, hlit - 257, 5)
  bw_write_bits(bw, hdist - 1, 5)
  bw_write_bits(bw, hclen - 4, 4)
  let mut ci = 0
  while ci < hclen {
    bw_write_bits(bw, cl_lens[cl_order[ci]], 3)
    ci = ci + 1
  }
  let mut ri = 0
  while ri < rle_syms.length() {
    let s = rle_syms[ri]
    bw_write_bits(bw, cl_codes[s], cl_lens[s])
    if s == 16 {
      bw_write_bits(bw, rle_extra[ri], 2)
    } else if s == 17 {
      bw_write_bits(bw, rle_extra[ri], 3)
    } else if s == 18 {
      bw_write_bits(bw, rle_extra[ri], 7)
    }
    ri = ri + 1
  }
  let mut ti = 0
  while ti < tokens.length() {
    let _ = emit_deflate_token(bw, tokens[ti], lit_codes, lit_lens, dist_codes, dist_lens)
    ti = ti + 1
  }
  bw_write_bits(bw, lit_codes[256], lit_lens[256])
  match bw_finish_with_pad(bw, 0) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
}

///|
test "dynamic_huffman_edge_cases_hdist32_deep15_boundary_rle16_and_sync_blocks" {
  // 1. EOB-only dynamic block with empty distance tree (0 dist symbols).
  let ll_eob : FixedArray[Int] = FixedArray::make(288, 0)
  ll_eob[256] = 1
  let dl_empty : FixedArray[Int] = FixedArray::make(32, 0)
  let s_eob = pf_build_dynamic_stream(257, 1, ll_eob, dl_empty, [], false)
  let _ = pf_assert_roundtrip(s_eob, Bytes::new(0), "eob_only_empty_dist")

  // 2. Single-symbol distance tree (len=1) + hdist=31 and hdist=32 (unused zero lengths).
  let ll_single : FixedArray[Int] = FixedArray::make(288, 0)
  ll_single[65] = 2 // 'A'
  ll_single[256] = 2 // EOB
  ll_single[257] = 1 // len=3
  let dl_single : FixedArray[Int] = FixedArray::make(32, 0)
  dl_single[0] = 1 // dist=1
  let toks_single = [65, pack_match_token(3, 1, false)]
  let s_hd31 = pf_build_dynamic_stream(258, 31, ll_single, dl_single, toks_single, false)
  let _ = pf_assert_roundtrip(s_hd31, "AAAA".to_bytes(), "single_dist_hdist31")
  let s_hd32 = pf_build_dynamic_stream(258, 32, ll_single, dl_single, toks_single, false)
  let _ = pf_assert_roundtrip(s_hd32, "AAAA".to_bytes(), "single_dist_hdist32")

  // 3. Code 16 repeating across the litlen/dist boundary (litlen ends with length 2, dist starts with 2, 2, 2).
  let ll_bnd : FixedArray[Int] = FixedArray::make(288, 0)
  ll_bnd[66] = 1 // 'B'
  ll_bnd[256] = 2 // EOB
  ll_bnd[257] = 2 // len=3 (last litlen entry)
  let dl_bnd : FixedArray[Int] = FixedArray::make(32, 0)
  dl_bnd[0] = 2
  dl_bnd[1] = 2
  dl_bnd[2] = 2
  dl_bnd[3] = 2
  let s_bnd = pf_build_dynamic_stream(258, 4, ll_bnd, dl_bnd, [66, pack_match_token(3, 1, false)], true)
  let _ = pf_assert_roundtrip(s_bnd, "BBBB".to_bytes(), "rle16_across_litlen_dist_boundary")

  // 4. Deep 15-bit dynamic tree (lengths 1..15, Kraft sum = 1: one symbol each of len 1..14, two of len 15).
  let ll_deep : FixedArray[Int] = FixedArray::make(288, 0)
  let mut b = 1
  while b <= 14 {
    ll_deep[b] = b
    b = b + 1
  }
  ll_deep[15] = 15
  ll_deep[256] = 15
  let s_deep = pf_build_dynamic_stream(257, 1, ll_deep, dl_empty, [1, 7, 14, 15], false)
  let _ = pf_assert_roundtrip(s_deep, pf_bytes_from_ints([1, 7, 14, 15]), "deep_15bit_dynamic_tree")

  // 5. Empty stored sync block (BFINAL=0, LEN=0) followed by final Fixed block.
  let sync_stream = pf_bytes_from_ints([0x00, 0x00, 0x00, 0xFF, 0xFF, 0x03, 0x00])
  let _ = pf_assert_roundtrip(sync_stream, Bytes::new(0), "empty_stored_sync_block")
}

///|
test "reencode_rejects_corrupted_match_override_and_survives_fuzz_mutations" {
  // Craft a raw uncompressed corrections blob with op_full_match pointing at mismatched plain bytes.
  // Plain = "ABCDEFGH" (8 bytes); Fixed block, preset=0 (LiteralsOnly), plain_len=8:
  // streak=4 literals ("ABCD"), then op_full_match (len=4, dist=4 -> "ABCD" != "EFGH")!
  let w = ByteWriter::new(32)
  byw_write_u8(w, magic_0)
  byw_write_u8(w, magic_1)
  byw_write_u8(w, format_version)
  byw_write_u8(w, 1 | 4 | (preset_literals << 4)) // Fixed, BFINAL=1, preset=0
  byw_write_varint(w, 8)
  write_residual_tag(w, op_full_match, 4)
  byw_write_varint(w, 4 - 3) // len=4
  byw_write_varint(w, 4 - 1) // dist=4
  write_residual_tag(w, op_end_block, 0)
  byw_write_u8(w, 0) // trailing_pad
  let bad_corr = byw_finish(w)
  match reencode(bad_corr, "ABCDEFGH".to_bytes()) {
    Ok(_) => debug_assert(false, "mismatched op_full_match must be rejected")
    Err(_) => ()
  }
  // Same corrections with matching plain "ABCDABCD" must succeed.
  match reencode(bad_corr, "ABCDABCD".to_bytes()) {
    Ok(defl) => {
      let dec = match flate::deflate_decompress(defl) {
        Ok(b) => b
        Err(_) => Bytes::new(0)
      }
      debug_assert(pf_bytes_eq(dec, "ABCDABCD".to_bytes()), "valid match must inflate identically")
    }
    Err(e) => debug_assert(false, "valid match failed: " + e)
  }

  // Deterministic bit-flip & truncation fuzz loop on real corrections (0 panics).
  let sample = pf_repeat_bytes("fuzz-preflate-corrections-0123456789\n".to_bytes(), 40)
  let comp = match flate::deflate_compress(sample, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let res = match analyze(comp) {
    Ok(r) => r
    Err(_) => PreflateResult::{ compressed_size: 0, corrections: Bytes::new(0), plain: Bytes::new(0) }
  }
  let corr = res.corrections
  let clen = corr.length()
  // Truncations
  let mut t = 0
  while t < clen {
    let _ = reencode(corr.slice(0, t), sample)
    t = t + 1
  }
  // Single-byte mutations across entire corrections blob
  let mut m = 0
  while m < clen {
    let mut mut_c = Bytes::new(clen)
    let mut k = 0
    while k < clen {
      mut_c[k] = corr[k]
      k = k + 1
    }
    mut_c[m] = (corr[m].to_int() ^ 0x55).to_byte()
    match reencode(mut_c, sample) {
      Ok(rebuilt) => {
        // Any accepted mutation must still inflate to the exact same `sample`!
        let dec = match flate::deflate_decompress(rebuilt) {
          Ok(b) => b
          Err(_) => Bytes::new(0)
        }
        debug_assert(pf_bytes_eq(dec, sample), "mutated corrections inflated to wrong plaintext")
      }
      Err(_) => ()
    }
    m = m + 1
  }
}

///|
test "max_corrections_raw_cap_exact_boundary_raw_and_compressed" {
  // 1. Raw (uncompressed) wrapper: small stream whose raw corrections are < 32B.
  let small_plain = "hello preflate cap test!".to_bytes()
  let small_defl = match flate::deflate_compress(small_plain, 6) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let res_raw = match analyze(small_defl) {
    Ok(r) => r
    Err(_) => PreflateResult::{ compressed_size: 0, corrections: Bytes::new(0), plain: Bytes::new(0) }
  }
  debug_assert((res_raw.corrections[2].to_int() & flag_compressed) == 0, "expected raw wrapper")
  let raw_hdr_len = if (res_raw.corrections[2].to_int() & flag_pred_opts) != 0 { 4 } else { 3 }
  let exact_raw_cap = res_raw.corrections.length() - raw_hdr_len
  match analyze_stream_with_caps(small_defl, 1024, exact_raw_cap) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "analyze at exact raw cap should succeed: " + e)
  }
  match analyze_stream_with_caps(small_defl, 1024, exact_raw_cap - 1) {
    Ok(_) => debug_assert(false, "analyze at raw cap - 1 must fail")
    Err(_) => ()
  }
  match reencode_deflate_with_cap(res_raw.corrections, res_raw.plain, exact_raw_cap) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "reencode at exact raw cap should succeed: " + e)
  }
  match reencode_deflate_with_cap(res_raw.corrections, res_raw.plain, exact_raw_cap - 1) {
    Ok(_) => debug_assert(false, "reencode at raw cap - 1 must fail")
    Err(_) => ()
  }

  // 2. Compressed wrapper: build a stream with > 32B raw corrections (e.g. flate L1 on mixed data).
  let mixed = pf_make_lcg_bytes(4096, 99L).concat(pf_repeat_bytes("abcde12345".to_bytes(), 200))
  let mixed_defl = match flate::deflate_compress(mixed, 1) {
    Ok(b) => b
    Err(_) => Bytes::new(0)
  }
  let res_comp = match analyze(mixed_defl) {
    Ok(r) => r
    Err(_) => PreflateResult::{ compressed_size: 0, corrections: Bytes::new(0), plain: Bytes::new(0) }
  }
  debug_assert((res_comp.corrections[2].to_int() & flag_compressed) != 0, "expected compressed wrapper")
  let outer = ByteReader::new(res_comp.corrections)
  outer.pos = if (res_comp.corrections[2].to_int() & flag_pred_opts) != 0 { 4 } else { 3 }
  let exact_comp_raw_len = match byr_read_varint(outer) {
    Ok(v) => v
    Err(_) => 0
  }
  debug_assert(exact_comp_raw_len >= 32, "compressed raw_len should be >= 32")
  match analyze_stream_with_caps(mixed_defl, mixed.length(), exact_comp_raw_len) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "analyze at exact compressed raw cap should succeed: " + e)
  }
  match analyze_stream_with_caps(mixed_defl, mixed.length(), exact_comp_raw_len - 1) {
    Ok(_) => debug_assert(false, "analyze at compressed raw cap - 1 must fail")
    Err(_) => ()
  }
  match reencode_deflate_with_cap(res_comp.corrections, res_comp.plain, exact_comp_raw_len) {
    Ok(_) => ()
    Err(e) => debug_assert(false, "reencode at exact compressed raw cap should succeed: " + e)
  }
  match reencode_deflate_with_cap(res_comp.corrections, res_comp.plain, exact_comp_raw_len - 1) {
    Ok(_) => debug_assert(false, "reencode at compressed raw cap - 1 must fail")
    Err(_) => ()
  }
}

