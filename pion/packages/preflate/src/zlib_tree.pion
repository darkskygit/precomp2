///| Zlib-exact dynamic Huffman tree builder (`build_tree`/`gen_bitlen`) and RLE header predictor.

///| Predicted dynamic Huffman header matching zlib's `build_tree` + `scan_tree` output.
struct PredictedDynHeader {
  hlit : Int
  hdist : Int
  hclen : Int
  cl_lens : FixedArray[Int]
  rle_syms : Array[Int]
  rle_extra : Array[Int]
  lit_lens : FixedArray[Int]
  dist_lens : FixedArray[Int]
}

///| Compare two Huffman heap nodes using zlib's `smaller` tie-breaker (`freq`, then `depth`).
fn zt_smaller(freq : FixedArray[Int], depth : FixedArray[Int], n : Int, m : Int) -> Bool {
  freq[n] < freq[m] || (freq[n] == freq[m] && depth[n] <= depth[m])
}

///| Restore min-heap property starting at 1-based index `k`.
fn zt_downheap(
  heap : FixedArray[Int],
  heap_len : Int,
  freq : FixedArray[Int],
  depth : FixedArray[Int],
  start_k : Int,
) -> Unit {
  let v = heap[start_k]
  let mut k = start_k
  let mut j = k << 1
  while j <= heap_len {
    if j < heap_len && zt_smaller(freq, depth, heap[j + 1], heap[j]) {
      j = j + 1
    }
    if zt_smaller(freq, depth, v, heap[j]) {
      break
    }
    heap[k] = heap[j]
    k = j
    j = j << 1
  }
  heap[k] = v
}

///| Build length-limited canonical code lengths using zlib's exact `build_tree` + `gen_bitlen`.
///| Writes resulting lengths into `out_lens[0..num_syms]` and returns `max_code`.
fn zlib_build_tree(
  in_freqs : FixedArray[Int],
  num_syms : Int,
  max_bits : Int,
  out_lens : FixedArray[Int],
) -> Int {
  let total_nodes = 2 * num_syms + 1
  let freq : FixedArray[Int] = FixedArray::make(total_nodes, 0)
  let dad : FixedArray[Int] = FixedArray::make(total_nodes, 0)
  let len : FixedArray[Int] = FixedArray::make(total_nodes, 0)
  let depth : FixedArray[Int] = FixedArray::make(total_nodes, 0)
  let heap : FixedArray[Int] = FixedArray::make(total_nodes + 1, 0)

  let mut heap_len = 0
  let mut max_code = -1
  let mut n = 0
  while n < num_syms {
    out_lens[n] = 0
    if in_freqs[n] != 0 {
      freq[n] = in_freqs[n]
      heap_len = heap_len + 1
      heap[heap_len] = n
      max_code = n
      depth[n] = 0
    }
    n = n + 1
  }

  // Zlib forces at least two symbols in every dynamic tree.
  while heap_len < 2 {
    let node = if max_code < 2 {
      max_code = max_code + 1
      max_code
    } else {
      0
    }
    heap_len = heap_len + 1
    heap[heap_len] = node
    freq[node] = 1
    depth[node] = 0
  }

  let mut k = heap_len >> 1
  while k >= 1 {
    zt_downheap(heap, heap_len, freq, depth, k)
    k = k - 1
  }

  let mut next_node = num_syms
  let mut heap_max = 2 * num_syms + 1
  while heap_len >= 2 {
    let n1 = heap[1]
    heap[1] = heap[heap_len]
    heap_len = heap_len - 1
    zt_downheap(heap, heap_len, freq, depth, 1)

    let m = heap[1]
    heap_max = heap_max - 1
    heap[heap_max] = n1
    heap_max = heap_max - 1
    heap[heap_max] = m

    freq[next_node] = freq[n1] + freq[m]
    let d1 = depth[n1]
    let d2 = depth[m]
    depth[next_node] = (if d1 >= d2 { d1 } else { d2 }) + 1
    dad[n1] = next_node
    dad[m] = next_node
    heap[1] = next_node
    next_node = next_node + 1
    zt_downheap(heap, heap_len, freq, depth, 1)
  }
  heap_max = heap_max - 1
  heap[heap_max] = heap[1]

  // gen_bitlen: assign depths and clamp to max_bits with zlib overflow redistribution.
  let bl_count : FixedArray[Int] = FixedArray::make(16, 0)
  len[heap[heap_max]] = 0
  let mut overflow = 0
  let mut h = heap_max + 1
  while h < 2 * num_syms + 1 {
    let sym = heap[h]
    let mut bits = len[dad[sym]] + 1
    if bits > max_bits {
      bits = max_bits
      overflow = overflow + 1
    }
    len[sym] = bits
    if sym <= max_code {
      bl_count[bits] = bl_count[bits] + 1
    }
    h = h + 1
  }

  if overflow > 0 {
    while overflow > 0 {
      let mut bits = max_bits - 1
      while bl_count[bits] == 0 {
        bits = bits - 1
      }
      bl_count[bits] = bl_count[bits] - 1
      bl_count[bits + 1] = bl_count[bits + 1] + 2
      bl_count[max_bits] = bl_count[max_bits] - 1
      overflow = overflow - 2
    }
    let mut rh = 2 * num_syms
    let mut bits = max_bits
    while bits >= 1 {
      let mut cnt = bl_count[bits]
      while cnt > 0 {
        let sym = heap[rh]
        rh = rh - 1
        if sym > max_code {
          continue
        }
        len[sym] = bits
        cnt = cnt - 1
      }
      bits = bits - 1
    }
  }

  let mut i = 0
  while i <= max_code {
    out_lens[i] = len[i]
    i = i + 1
  }
  max_code
}

///| Zlib's `scan_tree` + `send_tree` RLE for a single code-length array `lens[0..max_code]`.
fn zlib_rle_tree(
  lens : FixedArray[Int],
  max_code : Int,
  rle_syms : Array[Int],
  rle_extra : Array[Int],
  bl_freqs : FixedArray[Int],
) -> Unit {
  let mut prevlen = -1
  let mut nextlen = lens[0]
  let mut count = 0
  let mut max_count = if nextlen == 0 { 138 } else { 7 }
  let mut min_count = if nextlen == 0 { 3 } else { 4 }

  let mut n = 0
  while n <= max_code {
    let curlen = nextlen
    nextlen = if n + 1 <= max_code { lens[n + 1] } else { -1 }
    count = count + 1
    if count < max_count && curlen == nextlen {
      n = n + 1
      continue
    }
    if count < min_count {
      let mut k = 0
      while k < count {
        rle_syms.push(curlen)
        rle_extra.push(0)
        bl_freqs[curlen] = bl_freqs[curlen] + 1
        k = k + 1
      }
    } else if curlen != 0 {
      let mut rem = count
      if curlen != prevlen {
        rle_syms.push(curlen)
        rle_extra.push(0)
        bl_freqs[curlen] = bl_freqs[curlen] + 1
        rem = rem - 1
      }
      rle_syms.push(16)
      rle_extra.push(rem - 3)
      bl_freqs[16] = bl_freqs[16] + 1
    } else if count <= 10 {
      rle_syms.push(17)
      rle_extra.push(count - 3)
      bl_freqs[17] = bl_freqs[17] + 1
    } else {
      rle_syms.push(18)
      rle_extra.push(count - 11)
      bl_freqs[18] = bl_freqs[18] + 1
    }
    count = 0
    prevlen = curlen
    if nextlen == 0 {
      max_count = 138
      min_count = 3
    } else if curlen == nextlen {
      max_count = 6
      min_count = 3
    } else {
      max_count = 7
      min_count = 4
    }
    n = n + 1
  }
}

///| Predict the complete zlib dynamic Huffman header from a block's token frequencies.
fn predict_zlib_dynamic_header(
  lit_freqs : FixedArray[Int],
  dist_freqs : FixedArray[Int],
) -> PredictedDynHeader {
  let lit_lens : FixedArray[Int] = FixedArray::make(288, 0)
  let dist_lens : FixedArray[Int] = FixedArray::make(32, 0)
  let l_max = zlib_build_tree(lit_freqs, 286, 15, lit_lens)
  let d_max = zlib_build_tree(dist_freqs, 30, 15, dist_lens)
  let hlit = if l_max + 1 < 257 { 257 } else { l_max + 1 }
  let hdist = if d_max + 1 < 1 { 1 } else { d_max + 1 }

  let rle_syms : Array[Int] = []
  let rle_extra : Array[Int] = []
  let bl_freqs : FixedArray[Int] = FixedArray::make(19, 0)
  zlib_rle_tree(lit_lens, hlit - 1, rle_syms, rle_extra, bl_freqs)
  zlib_rle_tree(dist_lens, hdist - 1, rle_syms, rle_extra, bl_freqs)

  let cl_lens : FixedArray[Int] = FixedArray::make(19, 0)
  let _ = zlib_build_tree(bl_freqs, 19, 7, cl_lens)
  let mut max_bl = 18
  while max_bl >= 3 && cl_lens[cl_order[max_bl]] == 0 {
    max_bl = max_bl - 1
  }
  let hclen = max_bl + 1

  PredictedDynHeader::{ hlit, hdist, hclen, cl_lens, rle_syms, rle_extra, lit_lens, dist_lens }
}

///| Tally literal/length and distance symbol frequencies for a block's tokens (including EOB 256).
fn tally_token_freqs(
  tokens : Array[Int],
  lit_freqs : FixedArray[Int],
  dist_freqs : FixedArray[Int],
) -> Unit {
  let mut i = 0
  while i < 286 {
    lit_freqs[i] = 0
    i = i + 1
  }
  i = 0
  while i < 30 {
    dist_freqs[i] = 0
    i = i + 1
  }
  lit_freqs[256] = 1
  let n = tokens.length()
  i = 0
  while i < n {
    let tok = tokens[i]
    if !token_is_match(tok) {
      lit_freqs[tok] = lit_freqs[tok] + 1
    } else {
      let lsym = if token_is_alt_258(tok) { 284 } else { 257 + len_to_code[token_match_len(tok)] }
      lit_freqs[lsym] = lit_freqs[lsym] + 1
      let dsym = dist_to_code(token_match_dist(tok))
      dist_freqs[dsym] = dist_freqs[dsym] + 1
    }
    i = i + 1
  }
}

///| Check whether a predicted dynamic header matches a parsed dynamic header bit-for-bit.
fn dynamic_header_matches(
  pred : PredictedDynHeader,
  hlit : Int,
  hdist : Int,
  hclen : Int,
  cl_lens : FixedArray[Int],
  rle_syms : Array[Int],
  rle_extra : Array[Int],
) -> Bool {
  if pred.hlit != hlit || pred.hdist != hdist || pred.hclen != hclen {
    return false
  }
  let mut ci = 0
  while ci < hclen {
    let sym = cl_order[ci]
    if pred.cl_lens[sym] != cl_lens[sym] {
      return false
    }
    ci = ci + 1
  }
  let n_rle = rle_syms.length()
  if pred.rle_syms.length() != n_rle {
    return false
  }
  let mut i = 0
  while i < n_rle {
    if pred.rle_syms[i] != rle_syms[i] || pred.rle_extra[i] != rle_extra[i] {
      return false
    }
    i = i + 1
  }
  true
}
