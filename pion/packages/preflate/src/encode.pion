///| Incremental per-block corrections encoder with dynamic Huffman header prediction and `"PF"` wrapper.

import "flate"

///| Write `(op << 5) | min(streak, 31)` plus overflow varint if `streak >= 31`.
fn write_residual_tag(w : ByteWriter, op : Int, streak : Int) -> Unit {
  if streak < 31 {
    byw_write_u8(w, (op << 5) | streak)
  } else {
    byw_write_u8(w, (op << 5) | 31)
    byw_write_varint(w, streak - 31)
  }
}

///| Encode a verbatim dynamic Huffman header (`hlit`, `hdist`, `hclen`, 3-bit `cl_lens`, 1-byte/token RLE).
fn encode_verbatim_dynamic_header(
  w : ByteWriter,
  hlit : Int,
  hdist : Int,
  hclen : Int,
  cl_lens : FixedArray[Int],
  rle_syms : Array[Int],
  rle_extra : Array[Int],
) -> Unit {
  byw_write_u8(w, hlit - 257)
  byw_write_u8(w, hdist - 1)
  byw_write_u8(w, hclen - 4)

  let mut acc = 0
  let mut bits = 0
  let mut ci = 0
  while ci < hclen {
    acc = acc | ((cl_lens[cl_order[ci]] & 7) << bits)
    bits = bits + 3
    while bits >= 8 {
      byw_write_u8(w, acc & 0xFF)
      acc = acc >> 8
      bits = bits - 8
    }
    ci = ci + 1
  }
  if bits > 0 {
    byw_write_u8(w, acc & 0xFF)
  }

  let rle_cnt = rle_syms.length()
  byw_write_varint(w, rle_cnt)
  let mut i = 0
  while i < rle_cnt {
    let sym = rle_syms[i]
    let ex = rle_extra[i]
    if sym < 16 {
      byw_write_u8(w, sym)
    } else if sym == 16 {
      byw_write_u8(w, 16 + ex)
    } else if sym == 17 {
      byw_write_u8(w, 20 + ex)
    } else {
      byw_write_u8(w, 28 + ex)
    }
    i = i + 1
  }
}

///| Append a Stored block (`btype == 0`) to the incremental corrections stream.
fn encode_stored_block(
  w : ByteWriter,
  bfinal : Bool,
  stored_pad_bits : Int,
  plain_len : Int,
) -> Unit {
  let fin_bit = if bfinal { 4 } else { 0 }
  let pad_bit = if stored_pad_bits != 0 { 8 } else { 0 }
  byw_write_u8(w, fin_bit | pad_bit)
  if stored_pad_bits != 0 {
    byw_write_u8(w, stored_pad_bits & 0x7F)
  }
  byw_write_varint(w, plain_len)
}

///| Append a Fixed or Dynamic Huffman block to the incremental corrections stream.
///| Returns `(preset, wbits, filtered)` selected for this block.
fn encode_huffman_block(
  w : ByteWriter,
  pred_state : PredictorState,
  plain : Bytes,
  block_start : Int,
  block_plain_len : Int,
  btype : Int,
  bfinal : Bool,
  hlit : Int,
  hdist : Int,
  hclen : Int,
  cl_lens : FixedArray[Int],
  rle_syms : Array[Int],
  rle_extra : Array[Int],
  tokens : Array[Int],
  match_count : Int,
  all_dist_one : Bool,
  max_obs_dist : Int,
  min_obs_len : Int,
  cached_preset : Int,
  cached_wbits : Int,
  cached_filtered : Bool,
  lit_freqs : FixedArray[Int],
  dist_freqs : FixedArray[Int],
) -> (Int, Int, Bool) {
  let block_end = block_start + block_plain_len
  let (preset, wbits, filtered) = select_block_preset(
    pred_state,
    plain,
    block_start,
    block_end,
    tokens,
    match_count,
    all_dist_one,
    max_obs_dist,
    min_obs_len,
    cached_preset,
    cached_wbits,
    cached_filtered,
  )
  if preset_uses_hash(preset) {
    pred_catch_up(pred_state, plain, block_start, block_end)
  }

  let mut huff_predicted = false
  if btype == 2 {
    tally_token_freqs(tokens, lit_freqs, dist_freqs)
    let pred_hdr = predict_zlib_dynamic_header(lit_freqs, dist_freqs)
    huff_predicted = dynamic_header_matches(pred_hdr, hlit, hdist, hclen, cl_lens, rle_syms, rle_extra)
  }

  let fin_bit = if bfinal { 4 } else { 0 }
  let pred_bit = if huff_predicted { flag_huff_predicted } else { 0 }
  let flags = btype | fin_bit | pred_bit | ((preset & 15) << 4)
  byw_write_u8(w, flags)
  byw_write_varint(w, block_plain_len)
  if btype == 2 && !huff_predicted {
    encode_verbatim_dynamic_header(w, hlit, hdist, hclen, cl_lens, rle_syms, rle_extra)
  }

  let n_toks = tokens.length()
  let mut pos = block_start
  let mut streak = 0
  let mut ti = 0
  while ti < n_toks {
    if w.overflow {
      return (preset, wbits, filtered)
    }
    let actual = tokens[ti]
    let (pred, nll, nld) = predict_token(pred_state, plain, pos, block_end, preset, wbits, filtered)
    if actual == pred {
      streak = streak + 1
    } else if !token_is_match(actual) {
      write_residual_tag(w, op_literal, streak)
      streak = 0
    } else if token_is_alt_258(actual) {
      write_residual_tag(w, op_alt_258, streak)
      byw_write_varint(w, token_match_dist(actual) - 1)
      streak = 0
    } else {
      let alen = token_match_len(actual)
      let adist = token_match_dist(actual)
      if token_is_match(pred) && token_match_dist(pred) == adist {
        write_residual_tag(w, op_len_delta, streak)
        byw_write_zigzag(w, alen - token_match_len(pred))
      } else if token_is_match(pred) && token_match_len(pred) == alen {
        write_residual_tag(w, op_dist_override, streak)
        byw_write_varint(w, adist - 1)
      } else {
        write_residual_tag(w, op_full_match, streak)
        byw_write_varint(w, alen - 3)
        byw_write_varint(w, adist - 1)
      }
      streak = 0
    }
    let adv = if token_is_match(actual) { token_match_len(actual) } else { 1 }
    let pass_nll = if actual == pred { nll } else { 0 }
    let pass_nld = if actual == pred { nld } else { 0 }
    pred_advance(pred_state, plain, pos, adv, block_end, preset, pass_nll, pass_nld)
    pos = pos + adv
    ti = ti + 1
  }
  write_residual_tag(w, op_end_block, streak)
  (preset, wbits, filtered)
}

///| Wrap finalized raw corrections bytes with `"PF"` magic, version, options, and optional `flate`.
fn finalize_corrections(
  w : ByteWriter,
  trailing_pad_bits : Int,
  wbits : Int,
  filtered : Bool,
) -> Result[Bytes, String] {
  byw_write_u8(w, trailing_pad_bits & 0x7F)
  if w.overflow {
    return Err("corrections payload exceeded maximum size")
  }
  let raw = byw_finish(w)
  let raw_len = raw.length()
  let has_opts = wbits != 15 || filtered
  let opts_flag = if has_opts { flag_pred_opts } else { 0 }
  let opts_byte = ((wbits - 9) & 7) | (if filtered { 8 } else { 0 })
  let hdr_len = if has_opts { 4 } else { 3 }

  if raw_len >= 32 {
    match flate::deflate_compress(raw, 6) {
      Ok(comp) => {
        let out = ByteWriter::new(comp.length() + 12)
        byw_write_u8(out, magic_0)
        byw_write_u8(out, magic_1)
        byw_write_u8(out, format_version | flag_compressed | opts_flag)
        if has_opts {
          byw_write_u8(out, opts_byte)
        }
        byw_write_varint(out, raw_len)
        byw_write_bytes(out, comp)
        let wrapped = byw_finish(out)
        if wrapped.length() < raw_len + hdr_len {
          return Ok(wrapped)
        }
      }
      Err(_) => ()
    }
  }

  let out = ByteWriter::new(raw_len + hdr_len)
  byw_write_u8(out, magic_0)
  byw_write_u8(out, magic_1)
  byw_write_u8(out, format_version | opts_flag)
  if has_opts {
    byw_write_u8(out, opts_byte)
  }
  byw_write_bytes(out, raw)
  Ok(byw_finish(out))
}
