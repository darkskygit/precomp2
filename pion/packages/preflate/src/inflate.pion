///| Parse-only raw DEFLATE inflater for the compressed corrections wrapper (exact length, no trailing bytes).

///| Decompress `comp` enforcing exact `expected_len` output and rejecting any trailing bytes.
fn inflate_exact_wrapper(comp : Bytes, expected_len : Int) -> Result[Bytes, String] {
  let br = BitReader::new(comp)
  let mut out = Bytes::new(0)
  let mut out_len = 0
  let mut out_cap = 0

  let dyn_litlen_lut : FixedArray[Int] = FixedArray::make(4096, 0)
  let dyn_dist_lut : FixedArray[Int] = FixedArray::make(2048, 0)
  let cl_lut : FixedArray[Int] = FixedArray::make(128, 0)
  let cl_lens : FixedArray[Int] = FixedArray::make(19, 0)
  let code_lens : FixedArray[Int] = FixedArray::make(320, 0)
  let litlen_lens : FixedArray[Int] = FixedArray::make(288, 0)
  let dist_lens : FixedArray[Int] = FixedArray::make(32, 0)
  let empty_rle : Array[Int] = []

  let mut bfinal = false
  while !bfinal {
    let hdr = match br_read_bits(br, 3) {
      Ok(v) => v
      Err(e) => return Err("failed to decompress corrections: " + e)
    }
    bfinal = (hdr & 1) != 0
    let btype = (hdr >> 1) & 3
    if btype == 3 {
      return Err("failed to decompress corrections: invalid block type 3")
    }
    if btype == 0 {
      let _ = br_align_byte(br)
      let slen = match br_read_u16_le(br) {
        Ok(v) => v
        Err(e) => return Err("failed to decompress corrections: " + e)
      }
      let nlen = match br_read_u16_le(br) {
        Ok(v) => v
        Err(e) => return Err("failed to decompress corrections: " + e)
      }
      if (slen ^ nlen) != 0xFFFF || slen > br.in_len - br.in_pos || slen > expected_len - out_len {
        return Err("failed to decompress corrections: invalid stored block")
      }
      if slen > 0 {
        if slen > out_cap - out_len {
          out = grow_plain_buf(out, out_len, out_len + slen, expected_len)
          out_cap = out.length()
        }
        let mut k = 0
        while k < slen {
          out[out_len + k] = comp[br.in_pos + k]
          k = k + 1
        }
        br.in_pos = br.in_pos + slen
        out_len = out_len + slen
      }
      continue
    }

    let mut cur_litlen = fixed_litlen_lut
    let mut cur_dist = fixed_dist_lut
    if btype == 2 {
      match parse_dynamic_header(
        br,
        cl_lut,
        cl_lens,
        code_lens,
        litlen_lens,
        dist_lens,
        dyn_litlen_lut,
        dyn_dist_lut,
        empty_rle,
        empty_rle,
        false,
      ) {
        Err(e) => return Err("failed to decompress corrections: " + e)
        Ok(_) => ()
      }
      cur_litlen = dyn_litlen_lut
      cur_dist = dyn_dist_lut
    }

    while true {
      let sym = match decode_huff_sym(br, cur_litlen, litlen_root_bits, litlen_root_mask) {
        Ok(s) => s
        Err(e) => return Err("failed to decompress corrections: " + e)
      }
      if sym < 256 {
        if 1 > expected_len - out_len {
          return Err("failed to decompress corrections: output exceeded raw_len")
        }
        if 1 > out_cap - out_len {
          out = grow_plain_buf(out, out_len, out_len + 1, expected_len)
          out_cap = out.length()
        }
        out[out_len] = sym.to_byte()
        out_len = out_len + 1
      } else if sym == 256 {
        break
      } else {
        let lidx = sym - 257
        if lidx < 0 || lidx >= 29 {
          return Err("failed to decompress corrections: invalid length symbol")
        }
        let lextra = match br_read_bits(br, len_extra[lidx]) {
          Ok(v) => v
          Err(e) => return Err("failed to decompress corrections: " + e)
        }
        let match_len = len_base[lidx] + lextra
        let dsym = match decode_huff_sym(br, cur_dist, dist_root_bits, dist_root_mask) {
          Ok(s) => s
          Err(e) => return Err("failed to decompress corrections: " + e)
        }
        if dsym < 0 || dsym >= 30 {
          return Err("failed to decompress corrections: invalid distance symbol")
        }
        let dextra = match br_read_bits(br, dist_extra[dsym]) {
          Ok(v) => v
          Err(e) => return Err("failed to decompress corrections: " + e)
        }
        let dist = dist_base[dsym] + dextra
        if dist < 1 || dist > out_len || dist > 32768 || match_len > expected_len - out_len {
          return Err("failed to decompress corrections: match out of bounds")
        }
        if match_len > out_cap - out_len {
          out = grow_plain_buf(out, out_len, out_len + match_len, expected_len)
          out_cap = out.length()
        }
        let src = out_len - dist
        let mut k = 0
        while k < match_len {
          out[out_len + k] = out[src + k]
          k = k + 1
        }
        out_len = out_len + match_len
      }
    }
  }
  let _ = br_align_byte(br)
  if br.in_pos != comp.length() {
    return Err("trailing bytes after compressed corrections payload")
  }
  if out_len != expected_len {
    return Err("decompressed corrections length mismatch")
  }
  if out_len == out_cap {
    Ok(out)
  } else {
    Ok(out.slice(0, out_len))
  }
}
