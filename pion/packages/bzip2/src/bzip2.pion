///| Minimal pure-Pion bzip2 codec for precomp2 (BZh1..BZh9).
///|
///| `compress` reproduces the exact bytes of the Rust `bzip2` 0.6.1 crate on its default
///| `libbz2-rs-sys` 0.2.3 backend (`BzEncoder::write_all` + `finish`, work factor 30), which
///| `rust/src/codec/bzip2.rs` uses. That makes PCF2 `Bzip2` segments replay with zero penalty
///| bytes across the Rust and Pion implementations. Where libbz2 1.0.8 (C) differs from that
///| backend, this package follows `libbz2-rs-sys` 0.2.3.
///|
///| Translated to Pion from bzip2/libbzip2 (Julian R Seward) and libbzip2-rs
///| (Trifecta Tech Foundation); see `NOTICE`.

///| Largest output `decompress` produces (`Int` maximum).
let unlimited_output : Int = 2147483647

///| Decompress the first bzip2 stream in `input`.
///| Fails on malformed, truncated or CRC-mismatched data; bytes after the stream end are ignored.
pub fn decompress(input : Bytes) -> Result[Bytes, String] {
  decompress_stream(input, unlimited_output)
}

///| Decompress like `decompress`, failing once the output would exceed `max_out` bytes.
///| Fails when `max_out` is negative.
pub fn decompress_limited(input : Bytes, max_out : Int) -> Result[Bytes, String] {
  decompress_stream(input, max_out)
}

///| Compress `input` into a bzip2 stream at block level `1..=9`.
pub fn compress(input : Bytes, level : Int) -> Result[Bytes, String] {
  if level < 1 || level > 9 {
    return Err("bzip2: level must be 1..=9")
  }
  Ok(compress_stream(input, level))
}
