///| Check whether a JPEG header contains a DHT (0xFFC4) segment before SOS/EOI.
pub fn jpeg_has_dht(jpeg : Bytes) -> Bool {
  let jlen = jpeg.length()
  if jlen < 4 || jpeg[0] != (0xFF).to_byte() || jpeg[1] != (0xD8).to_byte() {
    return false
  }
  let mut pos = 2
  while pos + 1 < jlen {
    if jpeg[pos] != (0xFF).to_byte() {
      pos += 1
      continue
    }
    while pos < jlen && jpeg[pos] == (0xFF).to_byte() {
      pos += 1
    }
    if pos >= jlen {
      break
    }
    let marker = jpeg[pos].to_int()
    pos += 1
    if marker == 0xD9 || marker == 0xDA {
      break
    }
    if marker == 0xD8 || marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7) {
      continue
    }
    if pos + 1 >= jlen {
      break
    }
    let seg_len = read_u16_be(jpeg, pos)
    if seg_len < 2 || pos + seg_len > jlen {
      break
    }
    if marker == 0xC4 {
      return true
    }
    pos += seg_len
  }
  false
}

fn find_ffda_insert_pos(jpeg : Bytes) -> Option[Int] {
  let jlen = jpeg.length()
  let mut found_ff = false
  let mut i = 0
  while i < jlen {
    let b = jpeg[i].to_int()
    if found_ff {
      if b == 0xDA {
        if i - 1 >= 0 {
          return Some(i - 1)
        }
        return None
      }
      found_ff = false
    } else {
      found_ff = b == 0xFF
    }
    i += 1
  }
  None
}

fn insert_mjpg_dht(jpeg : Bytes) -> Option[Bytes] {
  if jpeg.length() < 4 ||
  jpeg[0] != (0xFF).to_byte() ||
  jpeg[1] != (0xD8).to_byte() {
    return None
  }
  let insert_pos = match find_ffda_insert_pos(jpeg) {
    Some(p) => p
    None => return None
  }
  let out : Array[Byte] = []
  append_bytes_slice(out, jpeg, 0, insert_pos)
  append_bytes(out, mjpg_dht)
  append_bytes_slice(out, jpeg, insert_pos, jpeg.length())
  Some(bytes_from_array(out))
}

fn remove_mjpg_dht(jpeg : Bytes) -> Option[Bytes] {
  let jlen = jpeg.length()
  if jlen < mjpg_dht_len + 4 ||
  jpeg[0] != (0xFF).to_byte() ||
  jpeg[1] != (0xD8).to_byte() {
    return None
  }
  let insert_pos = match find_ffda_insert_pos(jpeg) {
    Some(p) => p
    None => return None
  }
  if insert_pos < mjpg_dht_len {
    return None
  }
  let start = insert_pos - mjpg_dht_len
  if !bytes_eq_range(jpeg, start, mjpg_dht, 0, mjpg_dht_len) {
    return None
  }
  let out : Array[Byte] = []
  append_bytes_slice(out, jpeg, 0, start)
  append_bytes_slice(out, jpeg, insert_pos, jlen)
  Some(bytes_from_array(out))
}

fn encode_jpg(input : Bytes) -> Result[Option[Pcf2Segment], Error] {
  if input.length() < 4 ||
  input[0] != (0xFF).to_byte() ||
  input[1] != (0xD8).to_byte() {
    return Ok(None)
  }
  let mut mjpg_used = false
  let mut jpeg = input
  let lep_res = if jpeg_has_dht(jpeg) {
    lepton::encode(jpeg)
  } else {
    match lepton::encode(jpeg) {
      Ok(v) => Ok(v)
      Err(_) =>
      match insert_mjpg_dht(jpeg) {
        Some(with_dht) => {
          mjpg_used = true
          jpeg = with_dht
          lepton::encode(jpeg)
        }
        None => return Ok(None)
      }
    }
  }
  let lepton_bytes = match lep_res {
    Ok(v) => v
    Err(_) => return Ok(None)
  }
  let restored = match lepton::decode(lepton_bytes) {
    Ok(v) => v
    Err(_) => return Ok(None)
  }
  if !bytes_eq(restored, jpeg) {
    return Ok(None)
  }
  let meta = bytes_from_array([
    (1).to_byte(),
    if mjpg_used { (1).to_byte() } else { (0).to_byte() },
  ])
  Ok(
    Some(Pcf2Segment::{
      kind: SegmentKind::Jpg.to_u8(),
      flags: (0).to_byte(),
      orig_len: input.length().to_int64().to_uint64(),
      meta,
      data: lepton_bytes,
    }),
  )
}

fn decode_jpg_segment(
  segment : Pcf2Segment,
  budget : DecodeBudget,
  config : DecodeConfig,
) -> Result[Bytes, Error] {
  if segment.meta.length() < 2 {
    return Err(Error::InvalidSegment("jpg meta"))
  }
  if segment.meta[0] != (1).to_byte() {
    return Err(Error::InvalidSegment("jpg meta_version"))
  }
  let mjpg_used = segment.meta[1] != (0).to_byte()
  let mut jpeg = match lepton::decode(segment.data) {
    Ok(v) => v
    Err(msg) => return Err(Error::Other("lepton decode failed: \{msg}"))
  }
  if mjpg_used {
    match remove_mjpg_dht(jpeg) {
      Some(stripped) => jpeg = stripped
      None => return Err(Error::InvalidSegment("jpg mjpg dht"))
    }
  }
  match budget.consume(jpeg.length(), config) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  Ok(jpeg)
}
