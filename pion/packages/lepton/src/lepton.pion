///| Minimal pure-Pion lossless JPEG recompression codec for precomp2.

import "flate"

let lepton_magic_0 : Int = 0x4C
let lepton_magic_1 : Int = 0x50
let lepton_version : Int = 0x01
let flag_header_deflated : Int = 0x80
let flag_std_dht_compacted : Int = 0x40
let max_meta_bytes : Int = 16777216
let max_scan_meta_items : Int = 1048576

///| Validate scan metadata bounds symmetrically in both `encode` and `decode`.
fn validate_scan_metas(metas : Array[ScanMeta]) -> Result[Unit, String] {
  let mut total_extra_ff = 0
  let mut i = 0
  while i < metas.length() {
    let m = metas[i]
    if m.pad_bits.length() > max_scan_meta_items {
      return Err("pad_bits count exceeds limit")
    }
    if m.rst_extra_ff.length() > max_scan_meta_items {
      return Err("rst_extra_ff count exceeds limit")
    }
    if m.seq_trailing_zrls.length() > max_scan_meta_items {
      return Err("seq_trailing_zrls count exceeds limit")
    }
    if m.prog_eob_runs.length() > max_scan_meta_items {
      return Err("prog_eob_runs count exceeds limit")
    }
    let mut j = 0
    while j < m.rst_extra_ff.length() {
      let v = m.rst_extra_ff[j]
      if v < 0 || v > max_output_bytes - total_extra_ff {
        return Err("rst_extra_ff total exceeds output limit")
      }
      total_extra_ff = total_extra_ff + v
      j = j + 1
    }
    i = i + 1
  }
  Ok(())
}

///| Serialize non-ECS JPEG chunks and per-scan bitstream metadata into one blob.
fn serialize_meta_blob(img : JpegImage, metas : Array[ScanMeta]) -> Bytes {
  let w = ByteWriter::new(512)
  bw_push_varint(w, img.scans.length())
  let mut i = 0
  while i < img.chunks.length() {
    let ch = img.chunks[i]
    bw_push_varint(w, ch.length())
    bw_push_bytes(w, ch)
    i = i + 1
  }
  i = 0
  while i < metas.length() {
    let m = metas[i]
    let has_zrl = m.seq_trailing_zrls.length() > 0
    let has_eob = m.prog_eob_runs.length() > 0
    let flags = (m.pad_mode & 0x03)
    | (if m.rst_extra_ff_mode == 1 { 0x04 } else { 0 })
    | (if has_zrl { 0x08 } else { 0 })
    | (if has_eob { 0x10 } else { 0 })
    bw_push_byte(w, flags)
    if m.pad_mode == 2 {
      bw_push_varint(w, m.pad_bits.length())
      let mut j = 0
      while j < m.pad_bits.length() {
        bw_push_byte(w, m.pad_bits[j])
        j = j + 1
      }
    }
    if m.rst_extra_ff_mode == 1 {
      bw_push_varint(w, m.rst_extra_ff.length())
      let mut j = 0
      while j < m.rst_extra_ff.length() {
        bw_push_varint(w, m.rst_extra_ff[j])
        j = j + 1
      }
    }
    if has_zrl {
      bw_push_varint(w, m.seq_trailing_zrls.length())
      let mut prev_idx = 0
      let mut j = 0
      while j < m.seq_trailing_zrls.length() {
        let (bidx, cnt) = m.seq_trailing_zrls[j]
        bw_push_varint(w, bidx - prev_idx)
        bw_push_byte(w, cnt)
        prev_idx = bidx
        j = j + 1
      }
    }
    if has_eob {
      bw_push_varint(w, m.prog_eob_runs.length())
      let mut j = 0
      while j < m.prog_eob_runs.length() {
        bw_push_varint(w, m.prog_eob_runs[j])
        j = j + 1
      }
    }
    bw_push_varint(w, m.trailing.length())
    bw_push_bytes(w, m.trailing)
    i = i + 1
  }
  bw_to_bytes(w)
}

///| Deserialize non-ECS JPEG chunks and per-scan metadata from `blob`.
fn deserialize_meta_blob(blob : Bytes) -> Result[(Array[Bytes], Array[ScanMeta]), String] {
  let r = ByteReader::new(blob)
  let num_scans = match br_read_varint(r) {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if num_scans <= 0 || num_scans > max_jpeg_scans {
    return Err("invalid scan count in lepton metadata")
  }
  let chunks : Array[Bytes] = []
  let mut i = 0
  while i <= num_scans {
    let clen = match br_read_varint(r) {
      Ok(n) => n
      Err(e) => return Err(e)
    }
    let ch = match br_read_bytes(r, clen) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    chunks.push(ch)
    i = i + 1
  }
  let metas : Array[ScanMeta] = []
  let mut total_extra_ff = 0
  i = 0
  while i < num_scans {
    let flags = match br_read_byte(r) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if (flags & 0xE0) != 0 {
      return Err("invalid scan flags in lepton metadata")
    }
    let pad_mode = flags & 0x03
    if pad_mode > 2 {
      return Err("invalid pad_mode in lepton metadata")
    }
    let rst_extra_ff_mode = if (flags & 0x04) != 0 { 1 } else { 0 }
    let has_zrl = (flags & 0x08) != 0
    let has_eob = (flags & 0x10) != 0

    let pad_bits : Array[Int] = []
    if pad_mode == 2 {
      let n = match br_read_varint(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if n > max_scan_meta_items {
        return Err("pad_bits count exceeds limit")
      }
      let mut j = 0
      while j < n {
        match br_read_byte(r) {
          Ok(v) => pad_bits.push(v)
          Err(e) => return Err(e)
        }
        j = j + 1
      }
    }
    let rst_extra_ff : Array[Int] = []
    if rst_extra_ff_mode == 1 {
      let n = match br_read_varint(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if n > max_scan_meta_items {
        return Err("rst_extra_ff count exceeds limit")
      }
      let mut j = 0
      while j < n {
        match br_read_varint(r) {
          Ok(v) => {
            if v > max_output_bytes - total_extra_ff {
              return Err("rst_extra_ff total exceeds output limit")
            }
            total_extra_ff = total_extra_ff + v
            rst_extra_ff.push(v)
          }
          Err(e) => return Err(e)
        }
        j = j + 1
      }
    }
    let seq_trailing_zrls : Array[(Int, Int)] = []
    if has_zrl {
      let n = match br_read_varint(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if n > max_scan_meta_items {
        return Err("seq_trailing_zrls count exceeds limit")
      }
      let mut prev_idx = 0
      let mut j = 0
      while j < n {
        let delta = match br_read_varint(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        let cnt = match br_read_byte(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if cnt < 1 || cnt > 4 {
          return Err("invalid trailing ZRL count")
        }
        prev_idx = prev_idx + delta
        seq_trailing_zrls.push((prev_idx, cnt))
        j = j + 1
      }
    }
    let prog_eob_runs : Array[Int] = []
    if has_eob {
      let n = match br_read_varint(r) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if n > max_scan_meta_items {
        return Err("prog_eob_runs count exceeds limit")
      }
      let mut j = 0
      while j < n {
        let run_len = match br_read_varint(r) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        if run_len < 1 || run_len > 0x7FFF {
          return Err("invalid progressive EOBRUN length")
        }
        prog_eob_runs.push(run_len)
        j = j + 1
      }
    }
    let tlen = match br_read_varint(r) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    let trailing = match br_read_bytes(r, tlen) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
    metas.push(ScanMeta::{
      pad_mode,
      pad_bits,
      rst_extra_ff_mode,
      rst_extra_ff,
      seq_trailing_zrls,
      prog_eob_runs,
      trailing,
    })
    i = i + 1
  }
  if r.pos != blob.length() {
    return Err("trailing bytes in lepton metadata")
  }
  Ok((chunks, metas))
}

///| Compare two `Bytes` buffers for exact byte equality.
fn bytes_equal(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Build a synthetic JPEG skeleton with empty ECS slots to re-parse headers on decode.
fn build_header_skeleton(chunks : Array[Bytes]) -> Bytes {
  let w = ByteWriter::new(512)
  let mut i = 0
  while i < chunks.length() {
    bw_push_bytes(w, chunks[i])
    i = i + 1
  }
  bw_to_bytes(w)
}

///| Strip `prog_eob_runs` from `metas` to test whether canonical progressive encoding suffices.
fn strip_prog_eob_runs(metas : Array[ScanMeta]) -> Array[ScanMeta] {
  let out : Array[ScanMeta] = []
  let mut i = 0
  while i < metas.length() {
    let m = metas[i]
    out.push(ScanMeta::{
      pad_mode: m.pad_mode,
      pad_bits: m.pad_bits,
      rst_extra_ff_mode: m.rst_extra_ff_mode,
      rst_extra_ff: m.rst_extra_ff,
      seq_trailing_zrls: m.seq_trailing_zrls,
      prog_eob_runs: [],
      trailing: m.trailing,
    })
    i = i + 1
  }
  out
}

///| Losslessly recompress a JPEG byte stream into a compact reversible payload.
pub fn encode(jpeg : Bytes) -> Result[Bytes, String] {
  let img = match parse_jpeg_structure(jpeg) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (coeffs, raw_metas) = match decode_all_scans(jpeg, img) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let canonical_metas = if img.is_progressive { strip_prog_eob_runs(raw_metas) } else { raw_metas }
  let metas = match encode_jpeg_from_coeffs(img, coeffs, canonical_metas) {
    Ok(v) => {
      if bytes_equal(v, jpeg) {
        canonical_metas
      } else if img.is_progressive {
        match encode_jpeg_from_coeffs(img, coeffs, raw_metas) {
          Ok(v2) => {
            if bytes_equal(v2, jpeg) {
              raw_metas
            } else {
              return Err("JPEG bitstream is not canonically reversible")
            }
          }
          Err(e) => return Err(e)
        }
      } else {
        return Err("JPEG bitstream is not canonically reversible")
      }
    }
    Err(e) => {
      if img.is_progressive {
        match encode_jpeg_from_coeffs(img, coeffs, raw_metas) {
          Ok(v2) => {
            if bytes_equal(v2, jpeg) {
              raw_metas
            } else {
              return Err(e)
            }
          }
          Err(e2) => return Err(e2)
        }
      } else {
        return Err(e)
      }
    }
  }
  match validate_scan_metas(metas) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let raw_meta = serialize_meta_blob(img, metas)
  if raw_meta.length() > max_meta_bytes {
    return Err("JPEG metadata exceeds limit")
  }
  let compacted = compact_std_dht(raw_meta)
  let (meta_for_flate, is_dht_compacted) = if compacted.length() < raw_meta.length() {
    (compacted, true)
  } else {
    (raw_meta, false)
  }
  let (stored_meta, is_deflated) = match flate::deflate_compress(meta_for_flate, 9) {
    Ok(comp) => {
      if comp.length() < meta_for_flate.length() {
        (comp, true)
      } else {
        (meta_for_flate, false)
      }
    }
    Err(_) => (meta_for_flate, false)
  }
  let out = ByteWriter::new(stored_meta.length() + 256)
  bw_push_byte(out, lepton_magic_0)
  bw_push_byte(out, lepton_magic_1)
  let ver_flags = lepton_version
  | (if is_deflated { flag_header_deflated } else { 0 })
  | (if is_dht_compacted { flag_std_dht_compacted } else { 0 })
  bw_push_byte(out, ver_flags)
  bw_push_varint(out, stored_meta.length())
  bw_push_bytes(out, stored_meta)
  match compress_dct_blocks(img, coeffs, out) {
    Ok(_) => Ok(bw_to_bytes(out))
    Err(e) => Err(e)
  }
}

///| Restore the original byte-exact JPEG stream from an encoded payload.
pub fn decode(data : Bytes) -> Result[Bytes, String] {
  if data.length() < 4 {
    return Err("truncated lepton header")
  }
  if data[0].to_int() != lepton_magic_0 || data[1].to_int() != lepton_magic_1 {
    return Err("invalid lepton magic")
  }
  let ver_flags = data[2].to_int()
  if (ver_flags & 0x3F) != lepton_version {
    return Err("unsupported lepton version")
  }
  let is_deflated = (ver_flags & flag_header_deflated) != 0
  let is_dht_compacted = (ver_flags & flag_std_dht_compacted) != 0
  let r = ByteReader::new(data)
  r.pos = 3
  let meta_len = match br_read_varint(r) {
    Ok(n) => n
    Err(e) => return Err(e)
  }
  if meta_len > max_meta_bytes {
    return Err("lepton metadata length exceeds limit")
  }
  let stored_meta = match br_read_bytes(r, meta_len) {
    Ok(b) => b
    Err(e) => return Err(e)
  }
  let inflated_meta = if is_deflated {
    match flate::deflate_decompress_with_limit(stored_meta, max_meta_bytes) {
      Ok(b) => b
      Err(e) => return Err("failed to inflate lepton metadata: " + flate::flate_error_message(e))
    }
  } else {
    stored_meta
  }
  let raw_meta = if is_dht_compacted {
    match expand_std_dht(inflated_meta, max_meta_bytes) {
      Ok(b) => b
      Err(e) => return Err(e)
    }
  } else {
    inflated_meta
  }
  let (chunks, metas) = match deserialize_meta_blob(raw_meta) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let skeleton = build_header_skeleton(chunks)
  let img = match parse_jpeg_structure(skeleton) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  if img.scans.length() != metas.length() || img.chunks.length() != chunks.length() {
    return Err("lepton metadata scan count mismatch")
  }
  let coeffs = match decompress_dct_blocks(img, data, r.pos, data.length()) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  encode_jpeg_from_coeffs(img, coeffs, metas)
}
