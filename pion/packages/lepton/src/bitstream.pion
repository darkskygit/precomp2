///| Byte and JPEG entropy bitstream readers and writers.

///| Growable chunked byte writer backed by `Bytes` buffers.
struct ByteWriter {
  mut buf : Bytes
  mut len : Int
  mut total_len : Int
  chunks : Array[Bytes]
}

///| Create a new `ByteWriter` with the given initial capacity.
fn ByteWriter::new(init_cap : Int) -> ByteWriter {
  let cap = if init_cap < 64 { 64 } else if init_cap > 65536 { 65536 } else { init_cap }
  ByteWriter::{ buf: Bytes::new(cap), len: 0, total_len: 0, chunks: [] }
}

///| Ensure space for `extra` additional bytes in the active chunk.
fn bw_ensure(bw : ByteWriter, extra : Int) -> Unit {
  let needed = bw.len + extra
  if needed <= bw.buf.length() {
    return
  }
  if bw.len >= 4096 {
    bw.chunks.push(bw.buf.slice(0, bw.len))
    bw.len = 0
    if extra <= bw.buf.length() {
      return
    }
    let mut new_cap = bw.buf.length() * 2
    while new_cap < extra {
      new_cap = new_cap * 2
    }
    bw.buf = Bytes::new(new_cap)
    return
  }
  let mut new_cap = bw.buf.length() * 2
  while new_cap < needed {
    new_cap = new_cap * 2
  }
  let next = Bytes::new(new_cap)
  let mut i = 0
  while i < bw.len {
    next[i] = bw.buf[i]
    i = i + 1
  }
  bw.buf = next
}

///| Append a single byte (low 8 bits of `v`).
fn bw_push_byte(bw : ByteWriter, v : Int) -> Unit {
  bw_ensure(bw, 1)
  bw.buf[bw.len] = (v & 0xFF).to_byte()
  bw.len = bw.len + 1
  bw.total_len = bw.total_len + 1
}

///| Append a slice `[start, end)` from `src`.
fn bw_push_slice(bw : ByteWriter, src : Bytes, start : Int, end : Int) -> Unit {
  let count = end - start
  if count <= 0 {
    return
  }
  bw.total_len = bw.total_len + count
  if count >= 4096 {
    if bw.len > 0 {
      bw.chunks.push(bw.buf.slice(0, bw.len))
      bw.len = 0
    }
    bw.chunks.push(src.slice(start, end))
    return
  }
  bw_ensure(bw, count)
  let mut i = 0
  while i < count {
    bw.buf[bw.len + i] = src[start + i]
    i = i + 1
  }
  bw.len = bw.len + count
}

///| Append all bytes of `src`.
fn bw_push_bytes(bw : ByteWriter, src : Bytes) -> Unit {
  bw_push_slice(bw, src, 0, src.length())
}

///| Append an unsigned LEB128 varint (`v >= 0`).
fn bw_push_varint(bw : ByteWriter, v : Int) -> Unit {
  let mut x = v
  while x >= 0x80 {
    bw_push_byte(bw, (x & 0x7F) | 0x80)
    x = x >> 7
  }
  bw_push_byte(bw, x & 0x7F)
}

///| Return the total number of bytes written so far in O(1).
fn bw_total_len(bw : ByteWriter) -> Int {
  bw.total_len
}

///| Materialize all written bytes into a single contiguous `Bytes`.
fn bw_to_bytes(bw : ByteWriter) -> Bytes {
  if bw.chunks.length() == 0 {
    return bw.buf.slice(0, bw.len)
  }
  let mut total = bw.len
  let mut i = 0
  while i < bw.chunks.length() {
    total = total + bw.chunks[i].length()
    i = i + 1
  }
  let out = Bytes::new(total)
  let mut pos = 0
  i = 0
  while i < bw.chunks.length() {
    let chunk = bw.chunks[i]
    let mut j = 0
    while j < chunk.length() {
      out[pos] = chunk[j]
      pos = pos + 1
      j = j + 1
    }
    i = i + 1
  }
  let mut j = 0
  while j < bw.len {
    out[pos] = bw.buf[j]
    pos = pos + 1
    j = j + 1
  }
  out
}

///| Cursor for reading structured binary payloads.
struct ByteReader {
  data : Bytes
  mut pos : Int
}

///| Create a `ByteReader` positioned at offset 0.
fn ByteReader::new(data : Bytes) -> ByteReader {
  ByteReader::{ data, pos: 0 }
}

///| Read one unsigned byte.
fn br_read_byte(br : ByteReader) -> Result[Int, String] {
  if br.pos >= br.data.length() {
    return Err("unexpected end of lepton stream")
  }
  let b = br.data[br.pos].to_int()
  br.pos = br.pos + 1
  Ok(b)
}

///| Read an unsigned LEB128 varint (up to 31-bit non-negative `Int`).
fn br_read_varint(br : ByteReader) -> Result[Int, String] {
  let mut result = 0
  let mut shift = 0
  while true {
    if br.pos >= br.data.length() {
      return Err("truncated varint")
    }
    let b = br.data[br.pos].to_int()
    br.pos = br.pos + 1
    if shift > 28 {
      return Err("varint overflow")
    }
    if shift == 28 && (b & 0xF8) != 0 {
      return Err("varint overflow")
    }
    result = result | ((b & 0x7F) << shift)
    if (b & 0x80) == 0 {
      return Ok(result)
    }
    shift = shift + 7
  }
  Err("varint overflow")
}

///| Read `len` raw bytes as a slice.
fn br_read_bytes(br : ByteReader, len : Int) -> Result[Bytes, String] {
  if len < 0 || len > br.data.length() - br.pos {
    return Err("truncated byte slice")
  }
  let out = br.data.slice(br.pos, br.pos + len)
  br.pos = br.pos + len
  Ok(out)
}

///| MSB-first JPEG entropy-coded bitstream reader with `0xFF 0x00` unstuffing.
struct JpegBitReader {
  data : Bytes
  mut pos : Int
  end : Int
  mut bitbuf : Int
  mut bitcnt : Int
  mut hit_marker : Bool
}

///| Create a `JpegBitReader` over `[start, end)`.
fn JpegBitReader::new(data : Bytes, start : Int, end : Int) -> JpegBitReader {
  JpegBitReader::{ data, pos: start, end, bitbuf: 0, bitcnt: 0, hit_marker: false }
}

///| Refill the bit buffer until at least `need` bits are available (up to 16).
fn jbr_fill(br : JpegBitReader, need : Int) -> Unit {
  while br.bitcnt < need && !br.hit_marker {
    if br.pos >= br.end {
      br.hit_marker = true
      return
    }
    let b = br.data[br.pos].to_int()
    if b == 0xFF {
      if br.pos + 1 >= br.end {
        br.hit_marker = true
        return
      }
      let next = br.data[br.pos + 1].to_int()
      if next == 0x00 {
        br.pos = br.pos + 2
        br.bitbuf = (br.bitbuf << 8) | 0xFF
        br.bitcnt = br.bitcnt + 8
      } else {
        br.hit_marker = true
        return
      }
    } else {
      br.pos = br.pos + 1
      br.bitbuf = (br.bitbuf << 8) | b
      br.bitcnt = br.bitcnt + 8
    }
  }
}

///| Read `nbits` (0..16) MSB-first unsigned bits.
fn jbr_read_bits(br : JpegBitReader, nbits : Int) -> Result[Int, String] {
  if nbits == 0 {
    return Ok(0)
  }
  if br.bitcnt < nbits {
    jbr_fill(br, nbits)
  }
  if br.bitcnt < nbits {
    return Err("unexpected end of JPEG entropy stream")
  }
  br.bitcnt = br.bitcnt - nbits
  let mask = (1 << nbits) - 1
  let v = (br.bitbuf >> br.bitcnt) & mask
  br.bitbuf = br.bitbuf & ((1 << br.bitcnt) - 1)
  Ok(v)
}

///| Read a single bit (0 or 1).
fn jbr_read_bit(br : JpegBitReader) -> Result[Int, String] {
  if br.bitcnt == 0 {
    jbr_fill(br, 1)
  }
  if br.bitcnt == 0 {
    return Err("unexpected end of JPEG entropy stream")
  }
  br.bitcnt = br.bitcnt - 1
  let v = (br.bitbuf >> br.bitcnt) & 1
  br.bitbuf = br.bitbuf & ((1 << br.bitcnt) - 1)
  Ok(v)
}

///| Convert an unsigned `nbits`-bit JPEG value to its signed magnitude.
fn jpeg_extend(v : Int, nbits : Int) -> Int {
  if nbits == 0 {
    return 0
  }
  let half = 1 << (nbits - 1)
  if v < half {
    v - ((1 << nbits) - 1)
  } else {
    v
  }
}

///| Read and sign-extend `nbits` JPEG coefficient bits.
fn jbr_read_extend(br : JpegBitReader, nbits : Int) -> Result[Int, String] {
  if nbits == 0 {
    return Ok(0)
  }
  match jbr_read_bits(br, nbits) {
    Ok(v) => Ok(jpeg_extend(v, nbits))
    Err(e) => Err(e)
  }
}

///| Rewind any full unread bytes back into `pos` and return `(pad_count, pad_value)`.
fn jbr_finish_interval(br : JpegBitReader) -> (Int, Int) {
  while br.bitcnt >= 8 {
    let b = br.bitbuf & 0xFF
    br.bitbuf = br.bitbuf >> 8
    br.bitcnt = br.bitcnt - 8
    br.pos = br.pos - (if b == 0xFF { 2 } else { 1 })
  }
  let pad_count = br.bitcnt
  let pad_val = if pad_count > 0 { br.bitbuf & ((1 << pad_count) - 1) } else { 0 }
  br.bitbuf = 0
  br.bitcnt = 0
  br.hit_marker = false
  (pad_count, pad_val)
}

///| Consume the expected `RSTm` marker (plus any extra `0xFF` fill bytes) and return the extra `0xFF` count.
fn jbr_consume_rst(br : JpegBitReader, expected_rst : Int) -> Result[Int, String] {
  let mut extra_ff = 0
  while br.pos + 1 < br.end && br.data[br.pos].to_int() == 0xFF && br.data[br.pos + 1].to_int() == 0xFF {
    extra_ff = extra_ff + 1
    br.pos = br.pos + 1
  }
  if br.pos + 1 >= br.end {
    return Err("missing JPEG restart marker")
  }
  let m0 = br.data[br.pos].to_int()
  let m1 = br.data[br.pos + 1].to_int()
  if m0 != 0xFF || m1 != (0xD0 + (expected_rst & 7)) {
    return Err("unexpected JPEG restart marker")
  }
  br.pos = br.pos + 2
  br.bitbuf = 0
  br.bitcnt = 0
  br.hit_marker = false
  Ok(extra_ff)
}

///| MSB-first JPEG entropy-coded bitstream writer with `0xFF 0x00` byte stuffing.
struct JpegBitWriter {
  out : ByteWriter
  mut bitbuf : Int
  mut bitcnt : Int
}

///| Create a `JpegBitWriter` appending into `out`.
fn JpegBitWriter::new(out : ByteWriter) -> JpegBitWriter {
  JpegBitWriter::{ out, bitbuf: 0, bitcnt: 0 }
}

///| Write `nbits` (0..16) MSB-first bits, byte-stuffing `0xFF` as `0xFF 0x00`.
fn jbw_write_bits(bw : JpegBitWriter, bits : Int, nbits : Int) -> Unit {
  if nbits == 0 {
    return
  }
  let mask = (1 << nbits) - 1
  bw.bitbuf = (bw.bitbuf << nbits) | (bits & mask)
  bw.bitcnt = bw.bitcnt + nbits
  while bw.bitcnt >= 8 {
    bw.bitcnt = bw.bitcnt - 8
    let b = (bw.bitbuf >> bw.bitcnt) & 0xFF
    bw_push_byte(bw.out, b)
    if b == 0xFF {
      bw_push_byte(bw.out, 0x00)
    }
  }
  bw.bitbuf = bw.bitbuf & ((1 << bw.bitcnt) - 1)
}

///| Flush the remaining partial byte using the exact `pad_mode` / `pad_val`.
fn jbw_finish_interval(bw : JpegBitWriter, pad_mode : Int, pad_val : Int) -> Unit {
  if bw.bitcnt > 0 {
    let rem = 8 - bw.bitcnt
    let fill = if pad_mode == 0 {
      (1 << rem) - 1
    } else if pad_mode == 1 {
      0
    } else {
      pad_val
    }
    jbw_write_bits(bw, fill, rem)
  }
  bw.bitbuf = 0
  bw.bitcnt = 0
}

///| Emit an `RSTm` marker with `extra_ff` leading `0xFF` fill bytes within `max_out`.
fn jbw_write_rst(
  bw : JpegBitWriter,
  rst_idx : Int,
  extra_ff : Int,
  max_out : Int
) -> Result[Unit, String] {
  if extra_ff < 0 || extra_ff > max_out - bw_total_len(bw.out) - 2 {
    return Err("reconstructed JPEG exceeds output limit")
  }
  let mut k = 0
  while k < extra_ff {
    bw_push_byte(bw.out, 0xFF)
    k = k + 1
  }
  bw_push_byte(bw.out, 0xFF)
  bw_push_byte(bw.out, 0xD0 + (rst_idx & 7))
  Ok(())
}
