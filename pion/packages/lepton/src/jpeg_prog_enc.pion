///| Progressive JPEG (SOF2) entropy scan encoder.

///| Return the largest EOBRUN length representable by `ac_tbl` (capped at 0x7FFF).
fn max_dht_eobrun(ac_tbl : HuffTable) -> Int {
  let mut r = 14
  while r >= 0 {
    if ac_tbl.enc_len[r << 4] > 0 {
      return (1 << (r + 1)) - 1
    }
    r = r - 1
  }
  1
}

///| Flush a pending progressive EOBRUN and buffered refinement bits.
fn flush_prog_eobrun(
  bw : JpegBitWriter,
  ac_tbl : HuffTable,
  eobrun : Int,
  ref_bits : Array[Int]
) -> Result[Unit, String] {
  if eobrun > 0 {
    let mut temp = eobrun
    let mut nbits = 0
    while temp > 1 {
      temp = temp >> 1
      nbits = nbits + 1
    }
    match jbw_write_huff(bw, ac_tbl, nbits << 4) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    if nbits > 0 {
      jbw_write_bits(bw, eobrun - (1 << nbits), nbits)
    }
  }
  let mut i = 0
  while i < ref_bits.length() {
    jbw_write_bits(bw, ref_bits[i], 1)
    i = i + 1
  }
  Ok(())
}

///| Encode a progressive scan (`SOF2`) from `coeffs` into `out`.
fn encode_progressive_scan(
  img : JpegImage,
  scan : ScanInfo,
  meta : ScanMeta,
  coeffs : Array[FixedArray[Int]],
  out : ByteWriter
) -> Result[Unit, String] {
  let bw = JpegBitWriter::new(out)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let mut eobrun = 0
  let mut ref_bits : Array[Int] = []
  let has_recorded_eob = meta.prog_eob_runs.length() > 0
  let mut eob_cursor = 0
  let mut zrl_cursor = 0
  let max_eob = if scan.ss > 0 {
    max_dht_eobrun(scan.ac_tables[scan.comps[0].ac_tbl])
  } else {
    0x7FFF
  }

  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let mut mcu_idx = 0
  let mut interval_idx = 0
  let mut mcu_in_interval = 0
  while mcu_idx < total_mcus {
    if bw_total_len(out) > max_output_bytes {
      return Err("reconstructed JPEG exceeds output limit")
    }
    if scan.ss == 0 {
      if ns == 1 {
        let sc = scan.comps[0]
        let ci = img.components[sc.comp_idx]
        let bx = mcu_idx % ci.actual_w
        let by = mcu_idx / ci.actual_w
        let base = (by * ci.stride_w + bx) * 64
        let v = coeffs[sc.comp_idx][base]
        if scan.ah == 0 {
          let dc = v >> scan.al
          let diff = dc - prev_dc[0]
          prev_dc[0] = dc
          let cat = jpeg_category(diff)
          match jbw_write_huff(bw, scan.dc_tables[sc.dc_tbl], cat) {
            Ok(_) => ()
            Err(e) => return Err(e)
          }
          jbw_write_coeff_bits(bw, diff, cat)
        } else {
          jbw_write_bits(bw, (v >> scan.al) & 1, 1)
        }
      } else {
        let mx = mcu_idx % img.mcu_w
        let my = mcu_idx / img.mcu_w
        let mut s = 0
        while s < ns {
          let sc = scan.comps[s]
          let ci = img.components[sc.comp_idx]
          let blk = coeffs[sc.comp_idx]
          let mut vy = 0
          while vy < ci.v_samp {
            let mut hx = 0
            while hx < ci.h_samp {
              let bx = mx * ci.h_samp + hx
              let by = my * ci.v_samp + vy
              let base = (by * ci.stride_w + bx) * 64
              let v = blk[base]
              if scan.ah == 0 {
                let dc = v >> scan.al
                let diff = dc - prev_dc[s]
                prev_dc[s] = dc
                let cat = jpeg_category(diff)
                match jbw_write_huff(bw, scan.dc_tables[sc.dc_tbl], cat) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
                jbw_write_coeff_bits(bw, diff, cat)
              } else {
                jbw_write_bits(bw, (v >> scan.al) & 1, 1)
              }
              hx = hx + 1
            }
            vy = vy + 1
          }
          s = s + 1
        }
      }
    } else {
      let sc = scan.comps[0]
      let ci = img.components[sc.comp_idx]
      let ac_tbl = scan.ac_tables[sc.ac_tbl]
      let bx = mcu_idx % ci.actual_w
      let by = mcu_idx / ci.actual_w
      let base = (by * ci.stride_w + bx) * 64
      let blk = coeffs[sc.comp_idx]
      let eob_limit = if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
        meta.prog_eob_runs[eob_cursor]
      } else {
        max_eob
      }
      let extra_zrls = if zrl_cursor < meta.seq_trailing_zrls.length() {
        let (bidx, cnt) = meta.seq_trailing_zrls[zrl_cursor]
        if bidx == mcu_idx {
          zrl_cursor = zrl_cursor + 1
          cnt
        } else {
          0
        }
      } else {
        0
      }
      if scan.ah == 0 {
        let mut run = 0
        let mut has_nz = false
        let mut k = scan.ss
        while k <= scan.se {
          let raw = blk[base + k]
          let q = if raw >= 0 { raw >> scan.al } else { -((-raw) >> scan.al) }
          if q == 0 {
            run = run + 1
          } else {
            if !has_nz {
              if eobrun > 0 {
                match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
                if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
                  eob_cursor = eob_cursor + 1
                }
                eobrun = 0
                ref_bits = []
              }
              has_nz = true
            }
            while run >= 16 {
              match jbw_write_huff(bw, ac_tbl, 0xF0) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              run = run - 16
            }
            let cat = jpeg_category(q)
            match jbw_write_huff(bw, ac_tbl, (run << 4) | cat) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            jbw_write_coeff_bits(bw, q, cat)
            run = 0
          }
          k = k + 1
        }
        if extra_zrls > 0 {
          if !has_nz && eobrun > 0 {
            match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
              eob_cursor = eob_cursor + 1
            }
            eobrun = 0
            ref_bits = []
          }
          let mut z = 0
          while z < extra_zrls && run >= 16 {
            match jbw_write_huff(bw, ac_tbl, 0xF0) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            run = run - 16
            z = z + 1
          }
        }
        if run > 0 {
          eobrun = eobrun + 1
          let cur_lim = if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
            meta.prog_eob_runs[eob_cursor]
          } else {
            max_eob
          }
          if eobrun == cur_lim || eobrun == max_eob {
            match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
              eob_cursor = eob_cursor + 1
            }
            eobrun = 0
            ref_bits = []
          }
        }
      } else {
        // AC refinement encoding
        let mut last_new = -1
        let mut k = scan.ss
        while k <= scan.se {
          let a = blk[base + k]
          let abs_a = if a < 0 { -a } else { a }
          if (abs_a >> scan.al) == 1 {
            last_new = k
          }
          k = k + 1
        }
        if last_new < 0 && extra_zrls == 0 {
          k = scan.ss
          while k <= scan.se {
            let a = blk[base + k]
            let abs_a = if a < 0 { -a } else { a }
            if (abs_a >> scan.ah) > 0 {
              ref_bits.push((abs_a >> scan.al) & 1)
            }
            k = k + 1
          }
          eobrun = eobrun + 1
          if eobrun == eob_limit || eobrun == max_eob {
            match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
              eob_cursor = eob_cursor + 1
            }
            eobrun = 0
            ref_bits = []
          }
        } else {
          if eobrun > 0 {
            match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
              eob_cursor = eob_cursor + 1
            }
            eobrun = 0
            ref_bits = []
          }
          let mut run = 0
          let mut emitted_tz = 0
          let mut pending : Array[Int] = []
          k = scan.ss
          while k <= scan.se {
            let a = blk[base + k]
            let abs_a = if a < 0 { -a } else { a }
            let shifted = abs_a >> scan.al
            if shifted == 0 {
              run = run + 1
              let emit_zrl = if run == 16 {
                if k < last_new {
                  true
                } else if emitted_tz < extra_zrls {
                  emitted_tz = emitted_tz + 1
                  true
                } else {
                  false
                }
              } else {
                false
              }
              if emit_zrl {
                match jbw_write_huff(bw, ac_tbl, 0xF0) {
                  Ok(_) => ()
                  Err(e) => return Err(e)
                }
                let mut j = 0
                while j < pending.length() {
                  jbw_write_bits(bw, pending[j], 1)
                  j = j + 1
                }
                pending = []
                run = 0
              }
            } else if shifted == 1 {
              match jbw_write_huff(bw, ac_tbl, (run << 4) | 1) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              jbw_write_bits(bw, if a > 0 { 1 } else { 0 }, 1)
              let mut j = 0
              while j < pending.length() {
                jbw_write_bits(bw, pending[j], 1)
                j = j + 1
              }
              pending = []
              run = 0
            } else {
              pending.push(shifted & 1)
            }
            k = k + 1
          }
          if run > 0 || pending.length() > 0 {
            eobrun = 1
            ref_bits = pending
            let next_lim = if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
              meta.prog_eob_runs[eob_cursor]
            } else {
              max_eob
            }
            if eobrun == next_lim || eobrun == max_eob {
              match flush_prog_eobrun(bw, ac_tbl, eobrun, ref_bits) {
                Ok(_) => ()
                Err(e) => return Err(e)
              }
              if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
                eob_cursor = eob_cursor + 1
              }
              eobrun = 0
              ref_bits = []
            }
          }
        }
      }
    }

    mcu_idx = mcu_idx + 1
    mcu_in_interval = mcu_in_interval + 1
    if scan.dri > 0 && mcu_in_interval == scan.dri && mcu_idx < total_mcus {
      if scan.ss > 0 && eobrun > 0 {
        let sc = scan.comps[0]
        match flush_prog_eobrun(bw, scan.ac_tables[sc.ac_tbl], eobrun, ref_bits) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        if has_recorded_eob && eob_cursor < meta.prog_eob_runs.length() {
          eob_cursor = eob_cursor + 1
        }
        eobrun = 0
        ref_bits = []
      }
      let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
        meta.pad_bits[interval_idx]
      } else {
        0
      }
      jbw_finish_interval(bw, meta.pad_mode, pv)
      let eff = if meta.rst_extra_ff_mode == 1 && interval_idx < meta.rst_extra_ff.length() {
        meta.rst_extra_ff[interval_idx]
      } else {
        0
      }
      match jbw_write_rst(bw, interval_idx, eff, max_output_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      interval_idx = interval_idx + 1
      mcu_in_interval = 0
      prev_dc[0] = 0
      prev_dc[1] = 0
      prev_dc[2] = 0
      prev_dc[3] = 0
    }
  }
  if scan.ss > 0 && eobrun > 0 {
    let sc = scan.comps[0]
    match flush_prog_eobrun(bw, scan.ac_tables[sc.ac_tbl], eobrun, ref_bits) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
    meta.pad_bits[interval_idx]
  } else {
    0
  }
  jbw_finish_interval(bw, meta.pad_mode, pv)
  if meta.trailing.length() > max_output_bytes - bw_total_len(out) {
    return Err("reconstructed JPEG exceeds output limit")
  }
  bw_push_bytes(out, meta.trailing)
  Ok(())
}
