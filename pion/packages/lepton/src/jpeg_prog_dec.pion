///| Progressive JPEG (SOF2) entropy scan decoder and scan dispatch.

///| Decode a progressive scan (`SOF2`: DC first/refine, AC first/refine) into `coeffs`.
fn decode_progressive_scan(
  jpeg : Bytes,
  img : JpegImage,
  scan : ScanInfo,
  coeffs : Array[FixedArray[Int]]
) -> Result[ScanMeta, String] {
  let br = JpegBitReader::new(jpeg, scan.ecs_start, scan.ecs_end)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let pad_counts : Array[Int] = []
  let pad_vals : Array[Int] = []
  let extra_ffs : Array[Int] = []
  let seq_trailing_zrls : Array[(Int, Int)] = []
  let prog_eob_runs : Array[Int] = []
  let mut eobrun = 0

  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let mut mcu_idx = 0
  let mut rst_idx = 0
  let mut mcu_in_interval = 0
  while mcu_idx < total_mcus {
    if scan.ss == 0 {
      // Progressive DC scan (interleaved or non-interleaved)
      if ns == 1 {
        let sc = scan.comps[0]
        let ci = img.components[sc.comp_idx]
        let bx = mcu_idx % ci.actual_w
        let by = mcu_idx / ci.actual_w
        let base = (by * ci.stride_w + bx) * 64
        let blk = coeffs[sc.comp_idx]
        if scan.ah == 0 {
          let dc_cat = match jbr_decode_huff(br, scan.dc_tables[sc.dc_tbl]) {
            Ok(s) => s
            Err(e) => return Err(e)
          }
          if dc_cat > 11 {
            return Err("invalid progressive DC category")
          }
          let diff = match jbr_read_extend(br, dc_cat) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          prev_dc[0] = prev_dc[0] + diff
          blk[base] = prev_dc[0] << scan.al
        } else {
          let bit = match jbr_read_bit(br) {
            Ok(b) => b
            Err(e) => return Err(e)
          }
          if bit != 0 {
            blk[base] = blk[base] | (1 << scan.al)
          }
        }
      } else {
        let mx = mcu_idx % img.mcu_w
        let my = mcu_idx / img.mcu_w
        let mut s = 0
        while s < ns {
          let sc = scan.comps[s]
          let ci = img.components[sc.comp_idx]
          let blk = coeffs[sc.comp_idx]
          let mut vy = 0
          while vy < ci.v_samp {
            let mut hx = 0
            while hx < ci.h_samp {
              let bx = mx * ci.h_samp + hx
              let by = my * ci.v_samp + vy
              let base = (by * ci.stride_w + bx) * 64
              if scan.ah == 0 {
                let dc_cat = match jbr_decode_huff(br, scan.dc_tables[sc.dc_tbl]) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
                if dc_cat > 11 {
                  return Err("invalid progressive DC category")
                }
                let diff = match jbr_read_extend(br, dc_cat) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
                prev_dc[s] = prev_dc[s] + diff
                blk[base] = prev_dc[s] << scan.al
              } else {
                let bit = match jbr_read_bit(br) {
                  Ok(b) => b
                  Err(e) => return Err(e)
                }
                if bit != 0 {
                  blk[base] = blk[base] | (1 << scan.al)
                }
              }
              hx = hx + 1
            }
            vy = vy + 1
          }
          s = s + 1
        }
      }
    } else {
      // Progressive AC scan (always single component)
      let sc = scan.comps[0]
      let ci = img.components[sc.comp_idx]
      let ac_tbl = scan.ac_tables[sc.ac_tbl]
      let bx = mcu_idx % ci.actual_w
      let by = mcu_idx / ci.actual_w
      let base = (by * ci.stride_w + bx) * 64
      let blk = coeffs[sc.comp_idx]
      let p1 = 1 << scan.al
      let m1 = -p1
      if scan.ah == 0 {
        // AC first scan
        if eobrun > 0 {
          eobrun = eobrun - 1
        } else {
          let mut trailing_zrls = 0
          let mut k = scan.ss
          while k <= scan.se {
            let rs = match jbr_decode_huff(br, ac_tbl) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let r = rs >> 4
            let s = rs & 0x0F
            if s == 0 {
              if r == 15 {
                k = k + 16
                if k > scan.se + 1 {
                  return Err("progressive AC first ZRL overflow")
                }
                trailing_zrls = trailing_zrls + 1
              } else {
                let extra = match jbr_read_bits(br, r) {
                  Ok(v) => v
                  Err(e) => return Err(e)
                }
                let run_len = (1 << r) + extra
                prog_eob_runs.push(run_len)
                eobrun = run_len - 1
                break
              }
            } else {
              k = k + r
              if k > scan.se {
                return Err("progressive AC first run overflow")
              }
              let coef_val = match jbr_read_extend(br, s) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              blk[base + k] = coef_val << scan.al
              trailing_zrls = 0
              k = k + 1
            }
          }
          if trailing_zrls > 0 {
            seq_trailing_zrls.push((mcu_idx, trailing_zrls))
          }
        }
      } else {
        // AC refinement scan
        let mut trailing_zrls = 0
        let mut k = scan.ss
        if eobrun == 0 {
          while k <= scan.se {
            let rs = match jbr_decode_huff(br, ac_tbl) {
              Ok(v) => v
              Err(e) => return Err(e)
            }
            let mut r = rs >> 4
            let s = rs & 0x0F
            let mut new_val = 0
            if s != 0 {
              if s != 1 {
                return Err("invalid AC refinement magnitude")
              }
              let sign_bit = match jbr_read_bit(br) {
                Ok(b) => b
                Err(e) => return Err(e)
              }
              new_val = if sign_bit != 0 { p1 } else { m1 }
            } else if r != 15 {
              let extra = match jbr_read_bits(br, r) {
                Ok(v) => v
                Err(e) => return Err(e)
              }
              let run_len = (1 << r) + extra
              prog_eob_runs.push(run_len)
              eobrun = run_len
              break
            }
            while k <= scan.se {
              let cur = blk[base + k]
              if cur != 0 {
                let corr = match jbr_read_bit(br) {
                  Ok(b) => b
                  Err(e) => return Err(e)
                }
                if corr != 0 {
                  if (cur & p1) == 0 {
                    blk[base + k] = if cur > 0 { cur + p1 } else { cur + m1 }
                  }
                }
              } else {
                if r == 0 {
                  break
                }
                r = r - 1
              }
              k = k + 1
            }
            if s != 0 {
              if k > scan.se {
                return Err("progressive AC refine run overflow")
              }
              blk[base + k] = new_val
              trailing_zrls = 0
              k = k + 1
            } else {
              trailing_zrls = trailing_zrls + 1
              k = k + 1
            }
          }
          if trailing_zrls > 0 {
            seq_trailing_zrls.push((mcu_idx, trailing_zrls))
          }
        }
        if eobrun > 0 {
          while k <= scan.se {
            let cur = blk[base + k]
            if cur != 0 {
              let corr = match jbr_read_bit(br) {
                Ok(b) => b
                Err(e) => return Err(e)
              }
              if corr != 0 {
                if (cur & p1) == 0 {
                  blk[base + k] = if cur > 0 { cur + p1 } else { cur + m1 }
                }
              }
            }
            k = k + 1
          }
          eobrun = eobrun - 1
        }
      }
    }

    mcu_idx = mcu_idx + 1
    mcu_in_interval = mcu_in_interval + 1
    if scan.dri > 0 && mcu_in_interval == scan.dri && mcu_idx < total_mcus {
      let (pc, pv) = jbr_finish_interval(br)
      pad_counts.push(pc)
      pad_vals.push(pv)
      match jbr_consume_rst(br, rst_idx) {
        Ok(eff) => extra_ffs.push(eff)
        Err(e) => return Err(e)
      }
      rst_idx = rst_idx + 1
      mcu_in_interval = 0
      eobrun = 0
      prev_dc[0] = 0
      prev_dc[1] = 0
      prev_dc[2] = 0
      prev_dc[3] = 0
    }
  }
  let (pc, pv) = jbr_finish_interval(br)
  pad_counts.push(pc)
  pad_vals.push(pv)
  let trailing = if br.pos < scan.ecs_end {
    jpeg.slice(br.pos, scan.ecs_end)
  } else {
    Bytes::new(0)
  }
  let (pad_mode, pad_bits) = classify_pad_bits(pad_counts, pad_vals)
  let (rst_extra_ff_mode, rst_extra_ff) = classify_rst_ff(extra_ffs)
  Ok(ScanMeta::{
    pad_mode,
    pad_bits,
    rst_extra_ff_mode,
    rst_extra_ff,
    seq_trailing_zrls,
    prog_eob_runs,
    trailing,
  })
}

///| Decode all scans of `img` into per-component 8x8 DCT coefficient arrays.
fn decode_all_scans(
  jpeg : Bytes,
  img : JpegImage
) -> Result[(Array[FixedArray[Int]], Array[ScanMeta]), String] {
  let mut approx_meta = 0
  let mut ch = 0
  while ch < img.chunks.length() {
    let clen = img.chunks[ch].length()
    if clen > max_meta_bytes - approx_meta {
      return Err("JPEG metadata exceeds limit")
    }
    approx_meta = approx_meta + clen
    ch = ch + 1
  }
  let coeffs : Array[FixedArray[Int]] = []
  let mut c = 0
  while c < img.components.length() {
    let ci = img.components[c]
    coeffs.push(FixedArray::make(ci.stride_w * ci.stride_h * 64, 0))
    c = c + 1
  }
  let metas : Array[ScanMeta] = []
  let mut s = 0
  while s < img.scans.length() {
    let scan = img.scans[s]
    let meta = if img.is_progressive {
      match decode_progressive_scan(jpeg, img, scan, coeffs) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
    } else {
      match decode_sequential_scan(jpeg, img, scan, coeffs) {
        Ok(m) => m
        Err(e) => return Err(e)
      }
    }
    let scan_meta_est = meta.trailing.length()
    + meta.pad_bits.length()
    + meta.rst_extra_ff.length()
    + meta.seq_trailing_zrls.length() * 2
    + meta.prog_eob_runs.length()
    if scan_meta_est > max_meta_bytes - approx_meta {
      return Err("JPEG metadata exceeds limit")
    }
    approx_meta = approx_meta + scan_meta_est
    metas.push(meta)
    s = s + 1
  }
  Ok((coeffs, metas))
}

///| Reconstruct the exact JPEG byte stream from parsed structure, coefficients, and scan metadata.
fn encode_jpeg_from_coeffs(
  img : JpegImage,
  coeffs : Array[FixedArray[Int]],
  metas : Array[ScanMeta]
) -> Result[Bytes, String] {
  let out = ByteWriter::new(1024)
  if img.chunks[0].length() > max_output_bytes {
    return Err("reconstructed JPEG exceeds output limit")
  }
  bw_push_bytes(out, img.chunks[0])
  let mut s = 0
  while s < img.scans.length() {
    let scan = img.scans[s]
    let meta = metas[s]
    let res = if img.is_progressive {
      encode_progressive_scan(img, scan, meta, coeffs, out)
    } else {
      encode_sequential_scan(img, scan, meta, coeffs, out)
    }
    match res {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
    let next_chunk = img.chunks[s + 1]
    if next_chunk.length() > max_output_bytes - bw_total_len(out) {
      return Err("reconstructed JPEG exceeds output limit")
    }
    bw_push_bytes(out, next_chunk)
    s = s + 1
  }
  Ok(bw_to_bytes(out))
}
