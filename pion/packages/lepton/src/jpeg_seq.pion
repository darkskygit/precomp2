///| Sequential JPEG (SOF0/SOF1) entropy scan decoder and encoder.

///| Decode one sequential 8x8 block and return `(dc, trailing_zrl_count)`.
fn decode_seq_block(
  br : JpegBitReader,
  dc_tbl : HuffTable,
  ac_tbl : HuffTable,
  block : FixedArray[Int],
  base : Int,
  prev_dc : Int
) -> Result[(Int, Int), String] {
  let dc_cat = match jbr_decode_huff(br, dc_tbl) {
    Ok(s) => s
    Err(e) => return Err(e)
  }
  if dc_cat > 11 {
    return Err("invalid DC category")
  }
  let dc_diff = match jbr_read_extend(br, dc_cat) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dc = prev_dc + dc_diff
  block[base] = dc

  let mut trailing_zrls = 0
  let mut k = 1
  while k < 64 {
    let rs = match jbr_decode_huff(br, ac_tbl) {
      Ok(s) => s
      Err(e) => return Err(e)
    }
    let run = rs >> 4
    let size = rs & 0x0F
    if size == 0 {
      if run == 15 {
        k = k + 16
        if k > 64 {
          return Err("AC ZRL overflow")
        }
        trailing_zrls = trailing_zrls + 1
      } else if run == 0 {
        break
      } else {
        return Err("invalid AC EOBRUN in sequential scan")
      }
    } else {
      if size > 10 {
        return Err("invalid AC category")
      }
      k = k + run
      if k >= 64 {
        return Err("AC run overflow")
      }
      let coef_val = match jbr_read_extend(br, size) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      block[base + k] = coef_val
      trailing_zrls = 0
      k = k + 1
    }
  }
  Ok((dc, trailing_zrls))
}

///| Encode one sequential 8x8 block into `bw`, preserving `extra_zrls` trailing ZRLs if any.
fn encode_seq_block(
  bw : JpegBitWriter,
  dc_tbl : HuffTable,
  ac_tbl : HuffTable,
  block : FixedArray[Int],
  base : Int,
  prev_dc : Int,
  extra_zrls : Int
) -> Result[Int, String] {
  let dc = block[base]
  let diff = dc - prev_dc
  let dc_cat = jpeg_category(diff)
  match jbw_write_huff(bw, dc_tbl, dc_cat) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  jbw_write_coeff_bits(bw, diff, dc_cat)

  let mut run = 0
  let mut k = 1
  while k < 64 {
    let v = block[base + k]
    if v == 0 {
      run = run + 1
    } else {
      while run >= 16 {
        match jbw_write_huff(bw, ac_tbl, 0xF0) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }
        run = run - 16
      }
      let size = jpeg_category(v)
      let rs = (run << 4) | size
      match jbw_write_huff(bw, ac_tbl, rs) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      jbw_write_coeff_bits(bw, v, size)
      run = 0
    }
    k = k + 1
  }
  if extra_zrls > 0 {
    let mut z = 0
    while z < extra_zrls && run >= 16 {
      match jbw_write_huff(bw, ac_tbl, 0xF0) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      run = run - 16
      z = z + 1
    }
  }
  if run > 0 {
    match jbw_write_huff(bw, ac_tbl, 0x00) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  Ok(dc)
}

///| Decode a sequential scan (`SOF0`/`SOF1`) into `coeffs`.
fn decode_sequential_scan(
  jpeg : Bytes,
  img : JpegImage,
  scan : ScanInfo,
  coeffs : Array[FixedArray[Int]]
) -> Result[ScanMeta, String] {
  let br = JpegBitReader::new(jpeg, scan.ecs_start, scan.ecs_end)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let pad_counts : Array[Int] = []
  let pad_vals : Array[Int] = []
  let extra_ffs : Array[Int] = []
  let seq_trailing_zrls : Array[(Int, Int)] = []

  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let mut mcu_idx = 0
  let mut block_seq_idx = 0
  let mut rst_idx = 0
  let mut mcu_in_interval = 0
  while mcu_idx < total_mcus {
    if ns == 1 {
      let sc = scan.comps[0]
      let ci = img.components[sc.comp_idx]
      let bx = mcu_idx % ci.actual_w
      let by = mcu_idx / ci.actual_w
      let base = (by * ci.stride_w + bx) * 64
      match decode_seq_block(
        br,
        scan.dc_tables[sc.dc_tbl],
        scan.ac_tables[sc.ac_tbl],
        coeffs[sc.comp_idx],
        base,
        prev_dc[0]
      ) {
        Ok((dc, tz)) => {
          prev_dc[0] = dc
          if tz > 0 {
            seq_trailing_zrls.push((block_seq_idx, tz))
          }
          block_seq_idx = block_seq_idx + 1
        }
        Err(e) => return Err(e)
      }
    } else {
      let mx = mcu_idx % img.mcu_w
      let my = mcu_idx / img.mcu_w
      let mut s = 0
      while s < ns {
        let sc = scan.comps[s]
        let ci = img.components[sc.comp_idx]
        let mut vy = 0
        while vy < ci.v_samp {
          let mut hx = 0
          while hx < ci.h_samp {
            let bx = mx * ci.h_samp + hx
            let by = my * ci.v_samp + vy
            let base = (by * ci.stride_w + bx) * 64
            match decode_seq_block(
              br,
              scan.dc_tables[sc.dc_tbl],
              scan.ac_tables[sc.ac_tbl],
              coeffs[sc.comp_idx],
              base,
              prev_dc[s]
            ) {
              Ok((dc, tz)) => {
                prev_dc[s] = dc
                if tz > 0 {
                  seq_trailing_zrls.push((block_seq_idx, tz))
                }
                block_seq_idx = block_seq_idx + 1
              }
              Err(e) => return Err(e)
            }
            hx = hx + 1
          }
          vy = vy + 1
        }
        s = s + 1
      }
    }
    mcu_idx = mcu_idx + 1
    mcu_in_interval = mcu_in_interval + 1
    if scan.dri > 0 && mcu_in_interval == scan.dri && mcu_idx < total_mcus {
      let (pc, pv) = jbr_finish_interval(br)
      pad_counts.push(pc)
      pad_vals.push(pv)
      match jbr_consume_rst(br, rst_idx) {
        Ok(eff) => extra_ffs.push(eff)
        Err(e) => return Err(e)
      }
      rst_idx = rst_idx + 1
      mcu_in_interval = 0
      prev_dc[0] = 0
      prev_dc[1] = 0
      prev_dc[2] = 0
      prev_dc[3] = 0
    }
  }
  let (pc, pv) = jbr_finish_interval(br)
  pad_counts.push(pc)
  pad_vals.push(pv)
  let trailing = if br.pos < scan.ecs_end {
    jpeg.slice(br.pos, scan.ecs_end)
  } else {
    Bytes::new(0)
  }
  let (pad_mode, pad_bits) = classify_pad_bits(pad_counts, pad_vals)
  let (rst_extra_ff_mode, rst_extra_ff) = classify_rst_ff(extra_ffs)
  Ok(ScanMeta::{
    pad_mode,
    pad_bits,
    rst_extra_ff_mode,
    rst_extra_ff,
    seq_trailing_zrls,
    prog_eob_runs: [],
    trailing,
  })
}

///| Encode a sequential scan (`SOF0`/`SOF1`) from `coeffs` into `out`.
fn encode_sequential_scan(
  img : JpegImage,
  scan : ScanInfo,
  meta : ScanMeta,
  coeffs : Array[FixedArray[Int]],
  out : ByteWriter
) -> Result[Unit, String] {
  let bw = JpegBitWriter::new(out)
  let ns = scan.comps.length()
  let prev_dc = FixedArray::make(4, 0)
  let total_mcus = if ns == 1 {
    let ci = img.components[scan.comps[0].comp_idx]
    ci.actual_w * ci.actual_h
  } else {
    img.mcu_w * img.mcu_h
  }

  let mut mcu_idx = 0
  let mut block_seq_idx = 0
  let mut zrl_cursor = 0
  let mut interval_idx = 0
  let mut mcu_in_interval = 0
  while mcu_idx < total_mcus {
    if bw_total_len(out) > max_output_bytes {
      return Err("reconstructed JPEG exceeds output limit")
    }
    if ns == 1 {
      let sc = scan.comps[0]
      let ci = img.components[sc.comp_idx]
      let bx = mcu_idx % ci.actual_w
      let by = mcu_idx / ci.actual_w
      let base = (by * ci.stride_w + bx) * 64
      let extra_zrls = if zrl_cursor < meta.seq_trailing_zrls.length() {
        let (bidx, cnt) = meta.seq_trailing_zrls[zrl_cursor]
        if bidx == block_seq_idx {
          zrl_cursor = zrl_cursor + 1
          cnt
        } else {
          0
        }
      } else {
        0
      }
      block_seq_idx = block_seq_idx + 1
      match encode_seq_block(
        bw,
        scan.dc_tables[sc.dc_tbl],
        scan.ac_tables[sc.ac_tbl],
        coeffs[sc.comp_idx],
        base,
        prev_dc[0],
        extra_zrls
      ) {
        Ok(dc) => prev_dc[0] = dc
        Err(e) => return Err(e)
      }
    } else {
      let mx = mcu_idx % img.mcu_w
      let my = mcu_idx / img.mcu_w
      let mut s = 0
      while s < ns {
        let sc = scan.comps[s]
        let ci = img.components[sc.comp_idx]
        let mut vy = 0
        while vy < ci.v_samp {
          let mut hx = 0
          while hx < ci.h_samp {
            let bx = mx * ci.h_samp + hx
            let by = my * ci.v_samp + vy
            let base = (by * ci.stride_w + bx) * 64
            let extra_zrls = if zrl_cursor < meta.seq_trailing_zrls.length() {
              let (bidx, cnt) = meta.seq_trailing_zrls[zrl_cursor]
              if bidx == block_seq_idx {
                zrl_cursor = zrl_cursor + 1
                cnt
              } else {
                0
              }
            } else {
              0
            }
            block_seq_idx = block_seq_idx + 1
            match encode_seq_block(
              bw,
              scan.dc_tables[sc.dc_tbl],
              scan.ac_tables[sc.ac_tbl],
              coeffs[sc.comp_idx],
              base,
              prev_dc[s],
              extra_zrls
            ) {
              Ok(dc) => prev_dc[s] = dc
              Err(e) => return Err(e)
            }
            hx = hx + 1
          }
          vy = vy + 1
        }
        s = s + 1
      }
    }
    mcu_idx = mcu_idx + 1
    mcu_in_interval = mcu_in_interval + 1
    if scan.dri > 0 && mcu_in_interval == scan.dri && mcu_idx < total_mcus {
      let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
        meta.pad_bits[interval_idx]
      } else {
        0
      }
      jbw_finish_interval(bw, meta.pad_mode, pv)
      let eff = if meta.rst_extra_ff_mode == 1 && interval_idx < meta.rst_extra_ff.length() {
        meta.rst_extra_ff[interval_idx]
      } else {
        0
      }
      match jbw_write_rst(bw, interval_idx, eff, max_output_bytes) {
        Ok(_) => ()
        Err(e) => return Err(e)
      }
      interval_idx = interval_idx + 1
      mcu_in_interval = 0
      prev_dc[0] = 0
      prev_dc[1] = 0
      prev_dc[2] = 0
      prev_dc[3] = 0
    }
  }
  let pv = if meta.pad_mode == 2 && interval_idx < meta.pad_bits.length() {
    meta.pad_bits[interval_idx]
  } else {
    0
  }
  jbw_finish_interval(bw, meta.pad_mode, pv)
  if meta.trailing.length() > max_output_bytes - bw_total_len(out) {
    return Err("reconstructed JPEG exceeds output limit")
  }
  bw_push_bytes(out, meta.trailing)
  Ok(())
}
