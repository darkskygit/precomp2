///| Block-level DCT coefficient stream compressor and decompressor.

///| Compress all component 8x8 DCT coefficient arrays into `out`.
fn compress_dct_blocks(
  img : JpegImage,
  coeffs : Array[FixedArray[Int]],
  out : ByteWriter
) -> Result[Unit, String] {
  let re = RangeEncoder::new(out)
  let model = DctModel::new()
  let mut c = 0
  while c < img.components.length() {
    let ci = img.components[c]
    let blk = coeffs[c]
    let bw = ci.stride_w
    let bh = ci.stride_h
    let chroma = if c == 0 { 0 } else { 1 }
    let nz_counts = FixedArray::make(bw * bh, 0)
    let dc_errs = FixedArray::make(bw * bh, 0)

    let mut by = 0
    while by < bh {
      let mut bx = 0
      while bx < bw {
        let idx = by * bw + bx
        let base = idx * 64
        let pred = if bx == 0 && by == 0 {
          0
        } else if by == 0 {
          blk[(idx - 1) * 64]
        } else if bx == 0 {
          blk[(idx - bw) * 64]
        } else {
          med_predict(blk[(idx - 1) * 64], blk[(idx - bw) * 64], blk[(idx - bw - 1) * 64])
        }
        let left_err = if bx > 0 { dc_errs[idx - 1] } else { 0 }
        let top_err = if by > 0 { dc_errs[idx - bw] } else { 0 }
        let max_err = if left_err > top_err { left_err } else { top_err }
        let diff = blk[base] - pred
        dc_errs[idx] = if diff < 0 { -diff } else { diff }
        match encode_dc_diff(re, model, chroma, dc_mag_bucket8(max_err), diff) {
          Ok(_) => ()
          Err(e) => return Err(e)
        }

        let mut nz = 0
        let mut k = 1
        while k < 64 {
          if blk[base + k] != 0 {
            nz = nz + 1
          }
          k = k + 1
        }
        nz_counts[idx] = nz
        let avg_nz = if bx == 0 && by == 0 {
          0
        } else if by == 0 {
          nz_counts[idx - 1]
        } else if bx == 0 {
          nz_counts[idx - bw]
        } else {
          (nz_counts[idx - 1] + nz_counts[idx - bw] + 1) >> 1
        }
        encode_nz_count(re, model, chroma, avg_nz_bucket8(avg_nz), nz)

        let mut rem = nz
        k = 1
        while rem > 0 && k < 64 {
          let v = blk[base + k]
          if rem != 64 - k {
            let l_nz = bx > 0 && blk[(idx - 1) * 64 + k] != 0
            let t_nz = by > 0 && blk[(idx - bw) * 64 + k] != 0
            let nb = if l_nz || t_nz { 1 } else { 0 }
            let nz_ctx = ((chroma * 16 + ac_band16(k)) * 4 + rem_nz_bucket4(rem)) * 2 + nb
            re_encode_bit(re, model.ac_nz, nz_ctx, if v != 0 { 1 } else { 0 })
          }
          if v != 0 {
            match encode_ac_nz_val(re, model, chroma, ac_band8(k), rem_nz_bucket4(rem), v) {
              Ok(_) => ()
              Err(e) => return Err(e)
            }
            rem = rem - 1
          }
          k = k + 1
        }
        bx = bx + 1
      }
      by = by + 1
    }
    c = c + 1
  }
  re_finish(re)
  Ok(())
}

///| Decompress all component 8x8 DCT coefficient arrays from `[start, end)`.
fn decompress_dct_blocks(
  img : JpegImage,
  data : Bytes,
  start : Int,
  end : Int
) -> Result[Array[FixedArray[Int]], String] {
  let rd = match RangeDecoder::new(data, start, end) {
    Ok(r) => r
    Err(e) => return Err(e)
  }
  let model = DctModel::new()
  let coeffs : Array[FixedArray[Int]] = []
  let mut c = 0
  while c < img.components.length() {
    let ci = img.components[c]
    let bw = ci.stride_w
    let bh = ci.stride_h
    let blk = FixedArray::make(bw * bh * 64, 0)
    let chroma = if c == 0 { 0 } else { 1 }
    let nz_counts = FixedArray::make(bw * bh, 0)
    let dc_errs = FixedArray::make(bw * bh, 0)

    let mut by = 0
    while by < bh {
      let mut bx = 0
      while bx < bw {
        if rd.eof_reads > 0 {
          return Err("truncated range-coded payload")
        }
        let idx = by * bw + bx
        let base = idx * 64
        let pred = if bx == 0 && by == 0 {
          0
        } else if by == 0 {
          blk[(idx - 1) * 64]
        } else if bx == 0 {
          blk[(idx - bw) * 64]
        } else {
          med_predict(blk[(idx - 1) * 64], blk[(idx - bw) * 64], blk[(idx - bw - 1) * 64])
        }
        let left_err = if bx > 0 { dc_errs[idx - 1] } else { 0 }
        let top_err = if by > 0 { dc_errs[idx - bw] } else { 0 }
        let max_err = if left_err > top_err { left_err } else { top_err }
        let diff = match
        decode_dc_diff(rd, model, chroma, dc_mag_bucket8(max_err)) {
          Ok(v) => v
          Err(e) => return Err(e)
        }
        dc_errs[idx] = if diff < 0 { -diff } else { diff }
        blk[base] = pred + diff

        let avg_nz = if bx == 0 && by == 0 {
          0
        } else if by == 0 {
          nz_counts[idx - 1]
        } else if bx == 0 {
          nz_counts[idx - bw]
        } else {
          (nz_counts[idx - 1] + nz_counts[idx - bw] + 1) >> 1
        }
        let nz = decode_nz_count(rd, model, chroma, avg_nz_bucket8(avg_nz))
        if nz < 0 || nz > 63 {
          return Err("invalid AC non-zero count in lepton stream")
        }
        nz_counts[idx] = nz

        let mut rem = nz
        let mut k = 1
        while rem > 0 && k < 64 {
          let is_nz = if rem == 64 - k {
            1
          } else {
            let l_nz = bx > 0 && blk[(idx - 1) * 64 + k] != 0
            let t_nz = by > 0 && blk[(idx - bw) * 64 + k] != 0
            let nb = if l_nz || t_nz { 1 } else { 0 }
            let nz_ctx = ((chroma * 16 + ac_band16(k)) * 4 + rem_nz_bucket4(rem)) * 2 + nb
            rd_decode_bit(rd, model.ac_nz, nz_ctx)
          }
          if is_nz != 0 {
            match decode_ac_nz_val(rd, model, chroma, ac_band8(k), rem_nz_bucket4(rem)) {
              Ok(v) => blk[base + k] = v
              Err(e) => return Err(e)
            }
            rem = rem - 1
          }
          k = k + 1
        }
        bx = bx + 1
      }
      by = by + 1
    }
    coeffs.push(blk)
    c = c + 1
  }
  match rd_check_eof(rd) {
    Ok(_) => Ok(coeffs)
    Err(e) => Err(e)
  }
}
