///| Standard ITU-T T.81 Annex K Huffman table deduplication for JPEG metadata blobs.

fn std_dht_from_hex(s : String) -> Bytes {
  let raw = s.to_bytes()
  let n = raw.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let h = raw[i * 2].to_int()
    let l = raw[i * 2 + 1].to_int()
    let hi = if h >= 48 && h <= 57 { h - 48 } else if h >= 97 && h <= 102 { h - 87 } else { h - 55 }
    let lo = if l >= 48 && l <= 57 { l - 48 } else if l >= 97 && l <= 102 { l - 87 } else { l - 55 }
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

///| ITU-T T.81 Annex K Table K.3 (DC Luma, 29 bytes including TcTh=0x00).
let std_dht_dc0 : Bytes = std_dht_from_hex(
  "0000010501010101010100000000000000000102030405060708090a0b"
)

///| ITU-T T.81 Annex K Table K.4 (DC Chroma, 29 bytes including TcTh=0x01).
let std_dht_dc1 : Bytes = std_dht_from_hex(
  "0100030101010101010101010000000000000102030405060708090a0b"
)

///| ITU-T T.81 Annex K Table K.5 (AC Luma, 179 bytes including TcTh=0x10).
let std_dht_ac0 : Bytes = std_dht_from_hex(
  ""
)

///| ITU-T T.81 Annex K Table K.6 (AC Chroma, 179 bytes including TcTh=0x11).
let std_dht_ac1 : Bytes = std_dht_from_hex(
  ""
)

///| Check whether `src` matches `pat` at offset `pos`.
fn bytes_match_at(src : Bytes, pos : Int, pat : Bytes) -> Bool {
  let plen = pat.length()
  if pos + plen > src.length() {
    return false
  }
  let mut i = 0
  while i < plen {
    if src[pos + i] != pat[i] {
      return false
    }
    i = i + 1
  }
  true
}

///| Replace exact Annex K DHT byte sequences with 2-byte escape tokens (`0xFE 1..4`).
fn compact_std_dht(src : Bytes) -> Bytes {
  let out = ByteWriter::new(src.length())
  let n = src.length()
  let mut i = 0
  while i < n {
    let b = src[i].to_int()
    if b == 0x00 && bytes_match_at(src, i, std_dht_dc0) {
      bw_push_byte(out, 0xFE)
      bw_push_byte(out, 1)
      i = i + std_dht_dc0.length()
    } else if b == 0x01 && bytes_match_at(src, i, std_dht_dc1) {
      bw_push_byte(out, 0xFE)
      bw_push_byte(out, 2)
      i = i + std_dht_dc1.length()
    } else if b == 0x10 && bytes_match_at(src, i, std_dht_ac0) {
      bw_push_byte(out, 0xFE)
      bw_push_byte(out, 3)
      i = i + std_dht_ac0.length()
    } else if b == 0x11 && bytes_match_at(src, i, std_dht_ac1) {
      bw_push_byte(out, 0xFE)
      bw_push_byte(out, 4)
      i = i + std_dht_ac1.length()
    } else if b == 0xFE {
      bw_push_byte(out, 0xFE)
      bw_push_byte(out, 0)
      i = i + 1
    } else {
      bw_push_byte(out, b)
      i = i + 1
    }
  }
  bw_to_bytes(out)
}

///| Expand `0xFE` Annex K DHT escape tokens back to the exact original bytes within `max_bytes`.
fn expand_std_dht(src : Bytes, max_bytes : Int) -> Result[Bytes, String] {
  let init_cap = if src.length() < 4096 { src.length() + 420 } else { 4096 }
  let out = ByteWriter::new(init_cap)
  let n = src.length()
  let mut written = 0
  let mut i = 0
  while i < n {
    let b = src[i].to_int()
    if b == 0xFE {
      if i + 1 >= n {
        return Err("truncated std DHT escape token")
      }
      let code = src[i + 1].to_int()
      i = i + 2
      if code == 0 {
        if written + 1 > max_bytes {
          return Err("expanded lepton metadata exceeds limit")
        }
        bw_push_byte(out, 0xFE)
        written = written + 1
      } else if code == 1 {
        let add = std_dht_dc0.length()
        if add > max_bytes - written {
          return Err("expanded lepton metadata exceeds limit")
        }
        bw_push_bytes(out, std_dht_dc0)
        written = written + add
      } else if code == 2 {
        let add = std_dht_dc1.length()
        if add > max_bytes - written {
          return Err("expanded lepton metadata exceeds limit")
        }
        bw_push_bytes(out, std_dht_dc1)
        written = written + add
      } else if code == 3 {
        let add = std_dht_ac0.length()
        if add > max_bytes - written {
          return Err("expanded lepton metadata exceeds limit")
        }
        bw_push_bytes(out, std_dht_ac0)
        written = written + add
      } else if code == 4 {
        let add = std_dht_ac1.length()
        if add > max_bytes - written {
          return Err("expanded lepton metadata exceeds limit")
        }
        bw_push_bytes(out, std_dht_ac1)
        written = written + add
      } else {
        return Err("invalid std DHT escape code")
      }
    } else {
      if written + 1 > max_bytes {
        return Err("expanded lepton metadata exceeds limit")
      }
      bw_push_byte(out, b)
      written = written + 1
      i = i + 1
    }
  }
  Ok(bw_to_bytes(out))
}
