///| Patch SOF0 width and height in a copy of minimal.jpg to craft dimension bombs.
fn patch_minimal_sof_dims(w : Int, h : Int) -> Bytes {
  let src = fixture_minimal_jpg()
  let out = Bytes::new(src.length())
  let mut i = 0
  while i < src.length() {
    out[i] = src[i]
    i = i + 1
  }
  // In minimal.jpg, SOF0 is at offset 184: FF C0 00 11 08 [H_hi H_lo W_hi W_lo]
  out[189] = ((h >> 8) & 0xFF).to_byte()
  out[190] = (h & 0xFF).to_byte()
  out[191] = ((w >> 8) & 0xFF).to_byte()
  out[192] = (w & 0xFF).to_byte()
  out
}

test "dc_drift_over_4096_luma_and_chroma_roundtrip" {
  let jpg = build_dc_drift_jpeg()
  let encoded = match encode(jpg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "dc_drift encode failed: " + e)
      Bytes::new(0)
    }
  }
  let decoded = match decode(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "dc_drift decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(decoded, jpg), "dc_drift roundtrip mismatch")
}

test "progressive_al5_and_jpegtran_progressive_optimize_roundtrip" {
  let al5 = build_prog_al5_jpeg()
  let enc_al5 = match encode(al5) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "prog_al5 encode failed: " + e)
      Bytes::new(0)
    }
  }
  let dec_al5 = match decode(enc_al5) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "prog_al5 decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(dec_al5, al5), "prog_al5 roundtrip mismatch")

  let jt = fixture_jpegtran_prog_opt()
  let enc_jt = match encode(jt) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "jpegtran_prog_opt encode failed: " + e)
      Bytes::new(0)
    }
  }
  let dec_jt = match decode(enc_jt) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "jpegtran_prog_opt decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(dec_jt, jt), "jpegtran_prog_opt roundtrip mismatch")
}

test "sequential_trailing_zrl_roundtrip" {
  let jpg = build_trailing_zrl_jpeg()
  let encoded = match encode(jpg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "trailing_zrl encode failed: " + e)
      Bytes::new(0)
    }
  }
  let decoded = match decode(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "trailing_zrl decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(decoded, jpg), "trailing_zrl roundtrip mismatch")
}

test "adversarial_bombs_varint_overflow_and_truncated_range_rejected" {
  // 1. Dimension bombs (65535x65535 and 16384x16384)
  match encode(patch_minimal_sof_dims(65535, 65535)) {
    Ok(_) => debug_assert(false, "65535x65535 must be rejected")
    Err(_) => ()
  }
  match encode(patch_minimal_sof_dims(16384, 16384)) {
    Ok(_) => debug_assert(false, "16384x16384 must be rejected")
    Err(_) => ()
  }

  // 2. DHT expansion bomb: 100,000 copies of FE 03 (expands to 17.9 MB > 16 MB limit)
  let bomb_raw = ByteWriter::new(200000)
  let mut k = 0
  while k < 100000 {
    bw_push_byte(bomb_raw, 0xFE)
    bw_push_byte(bomb_raw, 0x03)
    k = k + 1
  }
  let bomb_bytes = bw_to_bytes(bomb_raw)
  let bomb_deflated = match flate::deflate_compress(bomb_bytes, 6) {
    Ok(b) => b
    Err(_) => panic()
  }
  let bomb_lep = ByteWriter::new(bomb_deflated.length() + 16)
  bw_push_byte(bomb_lep, lepton_magic_0)
  bw_push_byte(bomb_lep, lepton_magic_1)
  bw_push_byte(bomb_lep, lepton_version | flag_header_deflated | flag_std_dht_compacted)
  bw_push_varint(bomb_lep, bomb_deflated.length())
  bw_push_bytes(bomb_lep, bomb_deflated)
  bw_push_bytes(bomb_lep, Bytes::new(8))
  match decode(bw_to_bytes(bomb_lep)) {
    Ok(_) => debug_assert(false, "DHT expansion bomb must be rejected")
    Err(_) => ()
  }

  // 3. Varint overflow at shift == 28 (high bits 0x78 set => negative / overflow)
  let vovf = ByteWriter::new(16)
  bw_push_byte(vovf, lepton_magic_0)
  bw_push_byte(vovf, lepton_magic_1)
  bw_push_byte(vovf, lepton_version)
  bw_push_byte(vovf, 0x80)
  bw_push_byte(vovf, 0x80)
  bw_push_byte(vovf, 0x80)
  bw_push_byte(vovf, 0x80)
  bw_push_byte(vovf, 0x08)
  match decode(bw_to_bytes(vovf)) {
    Ok(_) => debug_assert(false, "varint overflow must be rejected")
    Err(_) => ()
  }

  // 4. Truncated range-coded payload (drop 1, 2, 5 bytes) & trailing garbage (+1 byte)
  let valid_enc = match encode(fixture_photo64_base()) {
    Ok(b) => b
    Err(_) => panic()
  }
  let drops : Array[Int] = [1, 2, 5]
  let mut d = 0
  while d < drops.length() {
    let cut = valid_enc.slice(0, valid_enc.length() - drops[d])
    match decode(cut) {
      Ok(_) => debug_assert(false, "truncated range payload must be rejected")
      Err(_) => ()
    }
    d = d + 1
  }
  let extra = ByteWriter::new(valid_enc.length() + 1)
  bw_push_bytes(extra, valid_enc)
  bw_push_byte(extra, 0x00)
  match decode(bw_to_bytes(extra)) {
    Ok(_) => debug_assert(false, "trailing range payload byte must be rejected")
    Err(_) => ()
  }
}

test "deterministic_mutation_fuzz_never_panics_and_preserves_roundtrip" {
  let seeds : Array[Bytes] = [
    fixture_minimal_jpg(),
    fixture_qstream_jpg(),
    fixture_photo64_base(),
    fixture_photo64_prog(),
  ]
  let mut state = 0x5EED1234
  let mut s = 0
  while s < seeds.length() {
    let orig = seeds[s]
    let enc = match encode(orig) {
      Ok(b) => b
      Err(_) => panic()
    }
    // Mutate single bytes at pseudo-random positions in both JPEG and .lep inputs
    let mut iter = 0
    while iter < 32 {
      state = (state * 1103515245 + 12345) & 0x7FFFFFFF
      let jpos = state % orig.length()
      let mut_jpg = Bytes::new(orig.length())
      let mut i = 0
      while i < orig.length() {
        mut_jpg[i] = orig[i]
        i = i + 1
      }
      mut_jpg[jpos] = ((mut_jpg[jpos].to_int() ^ ((state >> 8) & 0xFF)) & 0xFF).to_byte()
      match encode(mut_jpg) {
        Ok(e2) => {
          let d2 = match decode(e2) {
            Ok(b) => b
            Err(err) => {
              debug_assert(false, "mutated JPEG encoded ok but decode failed: " + err)
              Bytes::new(0)
            }
          }
          debug_assert(bytes_equal(d2, mut_jpg), "mutated JPEG roundtrip mismatch")
        }
        Err(_) => ()
      }

      let epos = state % enc.length()
      let mut_lep = Bytes::new(enc.length())
      i = 0
      while i < enc.length() {
        mut_lep[i] = enc[i]
        i = i + 1
      }
      mut_lep[epos] = ((mut_lep[epos].to_int() ^ (((state >> 12) | 1) & 0xFF)) & 0xFF).to_byte()
      let _ = decode(mut_lep)
      iter = iter + 1
    }
    s = s + 1
  }
}

test "large_rst_extra_ff_symmetric_encode_decode_roundtrip" {
  // Inject 70,000 extra 0xFF fill bytes before RST0 in photo64_dri (exceeds old 65,536 cap).
  let base = fixture_photo64_dri()
  let mut rst_pos = -1
  let mut i = 2
  while i + 1 < base.length() {
    if base[i].to_int() == 0xFF && base[i + 1].to_int() == 0xD0 {
      rst_pos = i
      break
    }
    i = i + 1
  }
  debug_assert(rst_pos > 0, "photo64_dri must contain RST0")
  let out = ByteWriter::new(base.length() + 70000)
  bw_push_slice(out, base, 0, rst_pos)
  let mut f = 0
  while f < 70000 {
    bw_push_byte(out, 0xFF)
    f = f + 1
  }
  bw_push_slice(out, base, rst_pos, base.length())
  let big_rst_jpg = bw_to_bytes(out)
  let encoded = match encode(big_rst_jpg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "large_rst_extra_ff encode failed: " + e)
      Bytes::new(0)
    }
  }
  let decoded = match decode(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "large_rst_extra_ff decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(decoded, big_rst_jpg), "large_rst_extra_ff roundtrip mismatch")
}

test "progressive_ac_trailing_zrl_before_eobrun_roundtrip" {
  // Construct a valid progressive JPEG whose first AC scan (Ah == 0) has a trailing ZRL before EOBRUN.
  let base = fixture_jpegtran_prog_opt()
  let img = match parse_jpeg_structure(base) {
    Ok(v) => v
    Err(_) => panic()
  }
  let (coeffs, metas) = match decode_all_scans(base, img) {
    Ok(v) => v
    Err(_) => panic()
  }
  // Find first progressive AC first scan (ss > 0, ah == 0, se - ss + 1 >= 16) whose DHT contains 0xF0
  let mut target_scan = -1
  let mut s = 0
  while s < img.scans.length() {
    let sc = img.scans[s]
    if sc.ss > 0 && sc.ah == 0 && (sc.se - sc.ss + 1) >= 16 && sc.ac_tables[sc.comps[0].ac_tbl].enc_len[0xF0] > 0 {
      target_scan = s
      break
    }
    s = s + 1
  }
  debug_assert(target_scan >= 0, "photo64_prog must have an AC first scan >= 16 coeffs")
  let sc = img.scans[target_scan]
  let comp = sc.comps[0].comp_idx
  let mut k = sc.ss
  while k <= sc.se {
    coeffs[comp][k] = 0
    k = k + 1
  }
  let patched_metas : Array[ScanMeta] = []
  s = 0
  while s < metas.length() {
    let m = metas[s]
    if s == target_scan {
      patched_metas.push(ScanMeta::{
        pad_mode: m.pad_mode,
        pad_bits: m.pad_bits,
        rst_extra_ff_mode: m.rst_extra_ff_mode,
        rst_extra_ff: m.rst_extra_ff,
        seq_trailing_zrls: [(0, 1)],
        prog_eob_runs: [],
        trailing: m.trailing,
      })
    } else {
      patched_metas.push(m)
    }
    s = s + 1
  }
  let prog_zrl_jpg = match encode_jpeg_from_coeffs(img, coeffs, patched_metas) {
    Ok(v) => v
    Err(_) => panic()
  }
  let encoded = match encode(prog_zrl_jpg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "prog_ac_trailing_zrl encode failed: " + e)
      Bytes::new(0)
    }
  }
  let decoded = match decode(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, "prog_ac_trailing_zrl decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(decoded, prog_zrl_jpg), "prog_ac_trailing_zrl roundtrip mismatch")
}
