///| Strip all DHT (0xFFC4) segments from a baseline JPEG to simulate MJPEG.
fn strip_dht_segments(jpeg : Bytes) -> Bytes {
  let out = ByteWriter::new(jpeg.length())
  bw_push_slice(out, jpeg, 0, 2)
  let mut pos = 2
  while pos + 1 < jpeg.length() {
    if jpeg[pos].to_int() != 0xFF {
      bw_push_slice(out, jpeg, pos, jpeg.length())
      break
    }
    let m_start = pos
    while pos < jpeg.length() && jpeg[pos].to_int() == 0xFF {
      pos = pos + 1
    }
    if pos >= jpeg.length() {
      bw_push_slice(out, jpeg, m_start, jpeg.length())
      break
    }
    let marker = jpeg[pos].to_int()
    pos = pos + 1
    if marker == 0xDA || marker == 0xD9 {
      bw_push_slice(out, jpeg, m_start, jpeg.length())
      break
    }
    if marker == 0x01 || marker == 0xD8 || (marker >= 0xD0 && marker <= 0xD7) {
      bw_push_slice(out, jpeg, m_start, pos)
      continue
    }
    let seg_len = (jpeg[pos].to_int() << 8) | jpeg[pos + 1].to_int()
    let seg_end = pos + seg_len
    if marker != 0xC4 {
      bw_push_slice(out, jpeg, m_start, seg_end)
    }
    pos = seg_end
  }
  bw_to_bytes(out)
}

///| Insert MJPGDHT right before SOS (0xFF 0xDA), matching rust/src/codec/media.rs.
fn insert_mjpg_dht(jpeg : Bytes) -> Bytes {
  let dht = fixture_mjpg_dht()
  let mut pos = 2
  while pos + 1 < jpeg.length() {
    if jpeg[pos].to_int() == 0xFF && jpeg[pos + 1].to_int() == 0xDA {
      let out = ByteWriter::new(jpeg.length() + dht.length())
      bw_push_slice(out, jpeg, 0, pos)
      bw_push_bytes(out, dht)
      bw_push_slice(out, jpeg, pos, jpeg.length())
      return bw_to_bytes(out)
    }
    pos = pos + 1
  }
  jpeg
}

test "minimal_jpg_roundtrip_and_shrinks_below_220" {
  let jpeg = fixture_minimal_jpg()
  debug_assert(jpeg.length() == 222, "minimal.jpg length")
  let _ = assert_roundtrip_and_shrink("minimal.jpg", jpeg, 219)
}

test "truncated_minimal_jpg_missing_eoi_returns_err" {
  let jpeg = fixture_minimal_jpg()
  let truncated = jpeg.slice(0, jpeg.length() - 2)
  match encode(truncated) {
    Ok(_) => debug_assert(false, "truncated JPEG missing EOI must fail")
    Err(_) => ()
  }
}

test "mjpeg_missing_dht_rejected_and_succeeds_with_mjpgdht" {
  let base = fixture_photo64_base()
  let no_dht = strip_dht_segments(base)
  match encode(no_dht) {
    Ok(_) => debug_assert(false, "MJPEG without DHT must fail")
    Err(_) => ()
  }
  let with_mjpg_dht = insert_mjpg_dht(no_dht)
  let _ = assert_roundtrip_and_shrink("mjpeg+MJPGDHT", with_mjpg_dht, with_mjpg_dht.length() - 1)
}

test "qpdf_fixture_jpegs_roundtrip_and_shrink" {
  let qstream = fixture_qstream_jpg()
  debug_assert(qstream.length() == 159, "jpeg-qstream length")
  let _ = assert_roundtrip_and_shrink("jpeg-qstream.pdf", qstream, qstream.length() - 3)

  let cmyk = fixture_small_cmyk_jpg()
  let _ = assert_roundtrip_and_shrink("image-streams-small CMYK", cmyk, cmyk.length() - 1)

  let yuv420 = fixture_small_420_jpg()
  let _ = assert_roundtrip_and_shrink("image-streams-small 4:2:0", yuv420, yuv420.length() - 1)

  let gray = fixture_small_gray_jpg()
  let _ = assert_roundtrip_and_shrink("image-streams-small Gray", gray, gray.length() - 1)
}

test "photographic_64x64_and_256x256_baseline_progressive_dri_sampling_roundtrip_and_compression" {
  let cases : Array[(String, Bytes, Int)] = [
    ("photo64_base", fixture_photo64_base(), 1300),
    ("photo64_prog", fixture_photo64_prog(), 1260),
    ("photo64_dri", fixture_photo64_dri(), 1320),
    ("photo64_444", fixture_photo64_444(), 1600),
    ("photo64_422", fixture_photo64_422(), 1400),
    ("photo64_gray", fixture_photo64_gray(), 880),
    ("photo256_base", fixture_photo256_base(), 6600),
    ("photo256_prog", fixture_photo256_prog(), 6600),
  ]
  let mut i = 0
  while i < cases.length() {
    let (label, jpg, max_sz) = cases[i]
    let _ = assert_roundtrip_and_shrink(label, jpg, max_sz)
    i = i + 1
  }
}

test "zero_pad_bits_extra_ff_fill_and_trailing_bytes_after_eoi_roundtrip" {
  // 1. Trailing bytes after EOI
  let base = fixture_minimal_jpg()
  let trail = ByteWriter::new(base.length() + 8)
  bw_push_bytes(trail, base)
  bw_push_byte(trail, 0xDE)
  bw_push_byte(trail, 0xAD)
  bw_push_byte(trail, 0xBE)
  bw_push_byte(trail, 0xEF)
  let with_trail = bw_to_bytes(trail)
  let _ = assert_roundtrip_and_shrink("minimal+trailing", with_trail, with_trail.length() - 1)

  // 2. Zero-fill pad bits in minimal.jpg (last ECS byte before EOI at offset 219)
  let zero_pad = Bytes::new(base.length())
  let mut i = 0
  while i < base.length() {
    zero_pad[i] = base[i]
    i = i + 1
  }
  // Clear low pad bits of the final ECS byte (minimal.jpg ECS is bytes 217..220)
  zero_pad[219] = (zero_pad[219].to_int() & 0xFE).to_byte()
  let _ = assert_roundtrip_and_shrink("minimal_zero_pad", zero_pad, zero_pad.length() - 1)

  // 3. Extra 0xFF fill bytes before EOI
  let extra_ff = ByteWriter::new(base.length() + 2)
  bw_push_slice(extra_ff, base, 0, base.length() - 2)
  bw_push_byte(extra_ff, 0xFF)
  bw_push_byte(extra_ff, 0xFF)
  bw_push_slice(extra_ff, base, base.length() - 2, base.length())
  let with_ff = bw_to_bytes(extra_ff)
  let _ = assert_roundtrip_and_shrink("minimal_extra_ff", with_ff, with_ff.length() - 1)
}

test "invalid_inputs_and_corrupted_payloads_rejected" {
  match encode(Bytes::new(0)) {
    Ok(_) => debug_assert(false, "empty input must fail")
    Err(_) => ()
  }
  match decode(Bytes::new(0)) {
    Ok(_) => debug_assert(false, "empty decode must fail")
    Err(_) => ()
  }
  let bad = Bytes::new(8)
  match decode(bad) {
    Ok(_) => debug_assert(false, "bad magic decode must fail")
    Err(_) => ()
