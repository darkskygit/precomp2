///| Deterministic unit and lossless compression tests for pure-Pion lepton.

import "flate"

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

fn hex_to_bytes(s : String) -> Bytes {
  let raw = s.to_bytes()
  let n = raw.length() / 2
  let out = Bytes::new(n)
  let mut i = 0
  while i < n {
    let hi = hex_nibble(raw[i * 2].to_int())
    let lo = hex_nibble(raw[i * 2 + 1].to_int())
    out[i] = ((hi << 4) | lo).to_byte()
    i = i + 1
  }
  out
}

fn assert_roundtrip_and_shrink(label : String, jpeg : Bytes, max_encoded : Int) -> Int {
  let encoded = match encode(jpeg) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, label + " encode failed: " + e)
      Bytes::new(0)
    }
  }
  let decoded = match decode(encoded) {
    Ok(b) => b
    Err(e) => {
      debug_assert(false, label + " decode failed: " + e)
      Bytes::new(0)
    }
  }
  debug_assert(bytes_equal(decoded, jpeg), label + " roundtrip mismatch")
  debug_assert(
    encoded.length() <= max_encoded,
    label + " encoded=" + encoded.length().to_string() + " exceeded max=" + max_encoded.to_string()
  )
  encoded.length()
}

