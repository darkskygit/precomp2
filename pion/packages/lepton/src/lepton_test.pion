///| Build a valid baseline JPEG with 64-block DC drift (> 5000) in both luma and chroma.
fn build_dc_drift_jpeg() -> Bytes {
  // Start from minimal.jpg header up to SOF0, patch width=64 (8x1 blocks, 4:4:4) and standard DHT
  let base = fixture_photo64_444()
  // Decode base structure, override coeffs with strong positive DC drift (+600 per block => DC > 4800 in Y, Cb, Cr)
  let img = match parse_jpeg_structure(base) {
    Ok(v) => v
    Err(_) => panic()
  }
  let (coeffs, metas) = match decode_all_scans(base, img) {
    Ok(v) => v
    Err(_) => panic()
  }
  let mut c = 0
  while c < coeffs.length() {
    let blk = coeffs[c]
    let ci = img.components[c]
    let total = ci.stride_w * ci.stride_h
    let mut b = 0
    while b < total {
      blk[b * 64] = (b + 1) * 900
      b = b + 1
    }
    c = c + 1
  }
  match encode_jpeg_from_coeffs(img, coeffs, metas) {
    Ok(v) => v
    Err(_) => panic()
  }
}

///| Build a valid sequential JPEG with trailing ZRL (0xF0) before EOB (0x00).
fn build_trailing_zrl_jpeg() -> Bytes {
  let base = fixture_photo64_base()
  let img = match parse_jpeg_structure(base) {
    Ok(v) => v
    Err(_) => panic()
  }
  let (coeffs, _) = match decode_all_scans(base, img) {
    Ok(v) => v
    Err(_) => panic()
  }
  // Clear AC coefficients in block 0 so it has 63 trailing zeros and inject 2 trailing ZRLs before EOB
  let mut k = 1
  while k < 64 {
    coeffs[0][k] = 0
    k = k + 1
  }
  let meta = ScanMeta::{
    pad_mode: 0,
    pad_bits: [],
    rst_extra_ff_mode: 0,
    rst_extra_ff: [],
    seq_trailing_zrls: [(0, 2)],
    prog_eob_runs: [],
    trailing: Bytes::new(0),
  }
  match encode_jpeg_from_coeffs(img, coeffs, [meta]) {
    Ok(v) => v
    Err(_) => panic()
  }
}

