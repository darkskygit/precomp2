///| Context tables, predictors, and symmetric DC/AC symbol coders for 8x8 DCT blocks.

let max_coeff_abs : Int = 1073741823
let max_coeff_exp : Int = 29

///| Map zig-zag index `1..63` to one of 16 frequency bands for `is_nonzero` contexts.
fn ac_band16(k : Int) -> Int {
  if k <= 8 {
    k - 1
  } else if k <= 14 {
    8 + ((k - 9) >> 1)
  } else if k <= 26 {
    11 + ((k - 15) >> 2)
  } else if k <= 42 {
    14
  } else {
    15
  }
}

///| Map zig-zag index `1..63` to one of 8 frequency bands for magnitude/sign contexts.
fn ac_band8(k : Int) -> Int {
  if k <= 2 {
    0
  } else if k <= 5 {
    1
  } else if k <= 9 {
    2
  } else if k <= 14 {
    3
  } else if k <= 20 {
    4
  } else if k <= 30 {
    5
  } else if k <= 45 {
    6
  } else {
    7
  }
}

///| Bucket remaining non-zero count into 4 states (`0..3`).
fn rem_nz_bucket4(rem : Int) -> Int {
  if rem <= 1 {
    0
  } else if rem <= 3 {
    1
  } else if rem <= 8 {
    2
  } else {
    3
  }
}

///| Bucket neighbor non-zero count average into 8 states (`0..7`).
fn avg_nz_bucket8(avg : Int) -> Int {
  if avg == 0 {
    0
  } else if avg == 1 {
    1
  } else if avg <= 3 {
    2
  } else if avg <= 7 {
    3
  } else if avg <= 14 {
    4
  } else if avg <= 24 {
    5
  } else if avg <= 39 {
    6
  } else {
    7
  }
}

///| Bucket DC residual magnitude into 8 states (`0..7`).
fn dc_mag_bucket8(mag : Int) -> Int {
  if mag == 0 {
    0
  } else if mag == 1 {
    1
  } else if mag <= 3 {
    2
  } else if mag <= 7 {
    3
  } else if mag <= 15 {
    4
  } else if mag <= 31 {
    5
  } else if mag <= 63 {
    6
  } else {
    7
  }
}

///| MED (JPEG-LS) gradient-clamped 2D predictor for DC coefficients.
fn med_predict(left : Int, top : Int, top_left : Int) -> Int {
  let min_lt = if left < top { left } else { top }
  let max_lt = if left > top { left } else { top }
  if top_left >= max_lt {
    min_lt
  } else if top_left <= min_lt {
    max_lt
  } else {
    left + top - top_left
  }
}

///| Compute floor(log2(v)) for `v >= 1`.
fn floor_log2(v : Int) -> Int {
  let mut e = 0
  let mut x = v >> 1
  while x > 0 {
    e = e + 1
    x = x >> 1
  }
  e
}

///| Adaptive probability tables for DCT coefficient coding.
struct DctModel {
  dc_nz : FixedArray[Int] // 2 * 8 = 16
  dc_sign : FixedArray[Int] // 2 * 8 = 16
  dc_gt1 : FixedArray[Int] // 2 * 8 = 16
  dc_exp : FixedArray[Int] // 2 * 8 * 12 = 192
  dc_mant : FixedArray[Int] // 2 * 12 = 24
  nz_zero : FixedArray[Int] // 2 * 8 = 16
  nz_exp : FixedArray[Int] // 2 * 8 * 6 = 96
  nz_mant : FixedArray[Int] // 2 * 6 * 5 = 60
  ac_nz : FixedArray[Int] // 2 * 16 * 4 * 2 = 256
  ac_sign : FixedArray[Int] // 2 * 8 = 16
  ac_gt1 : FixedArray[Int] // 2 * 8 * 4 = 64
  ac_exp : FixedArray[Int] // 2 * 8 * 11 = 176
  ac_mant : FixedArray[Int] // 2 * 8 * 11 = 176
}

///| Create a fresh `DctModel` with all probabilities initialized to 50%.
fn DctModel::new() -> DctModel {
  DctModel::{
    dc_nz: FixedArray::make(16, prob_init),
    dc_sign: FixedArray::make(16, prob_init),
    dc_gt1: FixedArray::make(16, prob_init),
    dc_exp: FixedArray::make(192, prob_init),
    dc_mant: FixedArray::make(24, prob_init),
    nz_zero: FixedArray::make(16, prob_init),
    nz_exp: FixedArray::make(96, prob_init),
    nz_mant: FixedArray::make(60, prob_init),
    ac_nz: FixedArray::make(256, prob_init),
    ac_sign: FixedArray::make(16, prob_init),
    ac_gt1: FixedArray::make(64, prob_init),
    ac_exp: FixedArray::make(176, prob_init),
    ac_mant: FixedArray::make(176, prob_init),
  }
}

///| Encode block AC non-zero count `nz` (`0..63`) conditioned on neighbor bucket.
fn encode_nz_count(re : RangeEncoder, model : DctModel, chroma : Int, avg_b : Int, nz : Int) -> Unit {
  let ctx = chroma * 8 + avg_b
  if nz == 0 {
    re_encode_bit(re, model.nz_zero, ctx, 0)
    return
  }
  re_encode_bit(re, model.nz_zero, ctx, 1)
  let exp = floor_log2(nz)
  let exp_base = ctx * 6
  let mut e = 0
  while e < exp && e < 5 {
    re_encode_bit(re, model.nz_exp, exp_base + e, 1)
    e = e + 1
  }
  if exp < 5 {
    re_encode_bit(re, model.nz_exp, exp_base + exp, 0)
  }
  let body = nz - (1 << exp)
  let mant_base = (chroma * 6 + exp) * 5
  let mut i = exp - 1
  while i >= 0 {
    re_encode_bit(re, model.nz_mant, mant_base + i, (body >> i) & 1)
    i = i - 1
  }
}

///| Decode block AC non-zero count (`0..63`).
fn decode_nz_count(rd : RangeDecoder, model : DctModel, chroma : Int, avg_b : Int) -> Int {
  let ctx = chroma * 8 + avg_b
  if rd_decode_bit(rd, model.nz_zero, ctx) == 0 {
    return 0
  }
  let exp_base = ctx * 6
  let mut exp = 0
  while exp < 5 {
    if rd_decode_bit(rd, model.nz_exp, exp_base + exp) == 0 {
      break
    }
    exp = exp + 1
  }
  let mant_base = (chroma * 6 + exp) * 5
  let mut body = 0
  let mut i = exp - 1
  while i >= 0 {
    body = (body << 1) | rd_decode_bit(rd, model.nz_mant, mant_base + i)
    i = i - 1
  }
  (1 << exp) + body
}

///| Encode a signed DC residual `diff` symmetrically up to `max_coeff_abs`.
fn encode_dc_diff(
  re : RangeEncoder,
  model : DctModel,
  chroma : Int,
  err_b : Int,
  diff : Int
) -> Result[Unit, String] {
  let base_ctx = chroma * 8 + err_b
  if diff == 0 {
    re_encode_bit(re, model.dc_nz, base_ctx, 0)
    return Ok(())
  }
  if diff < -max_coeff_abs || diff > max_coeff_abs {
    return Err("DC residual out of supported range")
  }
  re_encode_bit(re, model.dc_nz, base_ctx, 1)
  let sign = if diff < 0 { 1 } else { 0 }
  re_encode_bit(re, model.dc_sign, base_ctx, sign)
  let abs_v = if diff < 0 { -diff } else { diff }
  if abs_v == 1 {
    re_encode_bit(re, model.dc_gt1, base_ctx, 0)
    return Ok(())
  }
  re_encode_bit(re, model.dc_gt1, base_ctx, 1)
  let rem = abs_v - 2
  let exp = if rem == 0 { 0 } else { floor_log2(rem + 1) }
  let exp_base = base_ctx * 12
  let mut e = 0
  while e < exp && e < max_coeff_exp {
    let e_ctx = if e < 11 { e } else { 11 }
    re_encode_bit(re, model.dc_exp, exp_base + e_ctx, 1)
    e = e + 1
  }
  if exp < max_coeff_exp {
    let e_ctx = if exp < 11 { exp } else { 11 }
    re_encode_bit(re, model.dc_exp, exp_base + e_ctx, 0)
  }
  if exp > 0 {
    let body = (rem + 1) - (1 << exp)
    let top_bit = (body >> (exp - 1)) & 1
    let m_ctx = if exp < 11 { exp } else { 11 }
    re_encode_bit(re, model.dc_mant, chroma * 12 + m_ctx, top_bit)
    if exp > 1 {
      re_encode_direct_bits(re, body, exp - 1)
    }
  }
  Ok(())
}

///| Decode a signed DC residual, rejecting magnitudes above `max_coeff_abs`.
fn decode_dc_diff(rd : RangeDecoder, model : DctModel, chroma : Int, err_b : Int) -> Result[Int, String] {
  let base_ctx = chroma * 8 + err_b
  if rd_decode_bit(rd, model.dc_nz, base_ctx) == 0 {
    return Ok(0)
  }
  let sign = rd_decode_bit(rd, model.dc_sign, base_ctx)
  let abs_v = if rd_decode_bit(rd, model.dc_gt1, base_ctx) == 0 {
    1
  } else {
    let exp_base = base_ctx * 12
    let mut exp = 0
    while exp < max_coeff_exp {
      let e_ctx = if exp < 11 { exp } else { 11 }
      if rd_decode_bit(rd, model.dc_exp, exp_base + e_ctx) == 0 {
        break
      }
      exp = exp + 1
    }
    let rem = if exp == 0 {
      0
    } else {
      let m_ctx = if exp < 11 { exp } else { 11 }
      let top_bit = rd_decode_bit(rd, model.dc_mant, chroma * 12 + m_ctx)
      let low_bits = if exp > 1 { rd_decode_direct_bits(rd, exp - 1) } else { 0 }
      let body = (top_bit << (exp - 1)) | low_bits
      (1 << exp) + body - 1
    }
    if rem > max_coeff_abs - 2 {
      return Err("decoded DC residual out of supported range")
    }
    rem + 2
  }
  Ok(if sign != 0 { -abs_v } else { abs_v })
}

///| Encode a non-zero signed AC coefficient `v` symmetrically up to `max_coeff_abs`.
fn encode_ac_nz_val(
  re : RangeEncoder,
  model : DctModel,
  chroma : Int,
  b8 : Int,
  rem_b4 : Int,
  v : Int
) -> Result[Unit, String] {
  if v < -max_coeff_abs || v > max_coeff_abs {
    return Err("AC coefficient out of supported range")
  }
  let sign = if v < 0 { 1 } else { 0 }
  re_encode_bit(re, model.ac_sign, chroma * 8 + b8, sign)
  let abs_v = if v < 0 { -v } else { v }
  let gt1_ctx = (chroma * 8 + b8) * 4 + rem_b4
  if abs_v == 1 {
    re_encode_bit(re, model.ac_gt1, gt1_ctx, 0)
    return Ok(())
  }
  re_encode_bit(re, model.ac_gt1, gt1_ctx, 1)
  let rem = abs_v - 2
  let exp = if rem == 0 { 0 } else { floor_log2(rem + 1) }
  let exp_base = (chroma * 8 + b8) * 11
  let mut e = 0
  while e < exp && e < max_coeff_exp {
    let e_ctx = if e < 10 { e } else { 10 }
    re_encode_bit(re, model.ac_exp, exp_base + e_ctx, 1)
    e = e + 1
  }
  if exp < max_coeff_exp {
    let e_ctx = if exp < 10 { exp } else { 10 }
    re_encode_bit(re, model.ac_exp, exp_base + e_ctx, 0)
  }
  if exp > 0 {
    let body = (rem + 1) - (1 << exp)
    let top_bit = (body >> (exp - 1)) & 1
    let m_ctx = if exp < 10 { exp } else { 10 }
    re_encode_bit(re, model.ac_mant, exp_base + m_ctx, top_bit)
    if exp > 1 {
      re_encode_direct_bits(re, body, exp - 1)
    }
  }
  Ok(())
}

///| Decode a non-zero signed AC coefficient, rejecting magnitudes above `max_coeff_abs`.
fn decode_ac_nz_val(
  rd : RangeDecoder,
  model : DctModel,
  chroma : Int,
  b8 : Int,
  rem_b4 : Int
) -> Result[Int, String] {
  let sign = rd_decode_bit(rd, model.ac_sign, chroma * 8 + b8)
  let gt1_ctx = (chroma * 8 + b8) * 4 + rem_b4
  let abs_v = if rd_decode_bit(rd, model.ac_gt1, gt1_ctx) == 0 {
    1
  } else {
    let exp_base = (chroma * 8 + b8) * 11
    let mut exp = 0
    while exp < max_coeff_exp {
      let e_ctx = if exp < 10 { exp } else { 10 }
      if rd_decode_bit(rd, model.ac_exp, exp_base + e_ctx) == 0 {
        break
      }
      exp = exp + 1
    }
    let rem = if exp == 0 {
      0
    } else {
      let m_ctx = if exp < 10 { exp } else { 10 }
      let top_bit = rd_decode_bit(rd, model.ac_mant, exp_base + m_ctx)
      let low_bits = if exp > 1 { rd_decode_direct_bits(rd, exp - 1) } else { 0 }
      let body = (top_bit << (exp - 1)) | low_bits
      (1 << exp) + body - 1
    }
    if rem > max_coeff_abs - 2 {
      return Err("decoded AC coefficient out of supported range")
    }
    rem + 2
  }
  Ok(if sign != 0 { -abs_v } else { abs_v })
}
